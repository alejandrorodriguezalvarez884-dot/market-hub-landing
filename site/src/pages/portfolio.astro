---
// Where the user says what they own, or what they follow. First visit: a short welcome that
// asks which of the two it is.
import App from "../components/App.astro";
import Search from "../components/Search.astro";
---

<App title="Portfolio" description="Your positions and your watchlist.">
	<section id="welcome" class="panel mb-6 bg-gradient-to-br from-[#1b2a52] to-panel p-6" hidden>
		<p class="label text-[#5b8cff]">Welcome to My Hub</p>
		<h1 class="mt-1 text-2xl font-bold text-ink-strong">Do you have a portfolio?</h1>
		<p class="mt-2 text-[13px] text-muted">Add what you own to see its value and your gains, or just the stocks you follow. You can have both and change them any time.</p>
		<div class="mt-5 flex flex-wrap gap-3">
			<button type="button" data-go="positions" class="btn btn-primary">Yes, add my positions</button>
			<button type="button" data-go="watchlist" class="btn btn-ghost">No, pick stocks to follow</button>
		</div>
	</section>

	<div id="heading">
		<p class="label text-[#5b8cff]">My Hub</p>
		<h1 class="mt-1 text-2xl font-bold text-ink-strong">Your portfolio</h1>
		<p class="mt-1 text-[13px] text-muted">Positions you hold and stocks you follow. Saved to your private account.</p>
	</div>

	<section id="positions" class="panel mt-6 p-4 sm:p-5">
		<h2 class="panel-title">Positions</h2>
		<p class="mt-1 text-[13px] text-muted">Shares you hold and the average price you paid, to see your gain or loss. The average cost is optional.</p>
		<div class="mt-4 max-w-md"><Search mode="pick" button="Add" id="add-position" /></div>
		<div class="mt-4 overflow-x-auto">
			<table class="data-table">
				<thead><tr><th>Stock</th><th>Shares</th><th>Avg cost ($)</th><th></th></tr></thead>
				<tbody id="rows"></tbody>
			</table>
			<p id="no-rows" class="py-4 text-[13px] text-muted">No positions yet. Search a ticker or a company name to add one.</p>
		</div>
	</section>

	<section id="watchlist" class="panel mt-4 p-4 sm:p-5">
		<h2 class="panel-title">Watchlist</h2>
		<p class="mt-1 text-[13px] text-muted">Stocks you follow without owning them. Positions you hold are tracked already.</p>
		<div class="mt-4 max-w-md"><Search mode="pick" button="Add" id="add-favourite" /></div>
		<div id="chips" class="mt-4 flex flex-wrap gap-2"></div>
		<p id="no-chips" class="mt-2 text-[13px] text-muted">Nothing in your watchlist yet.</p>
	</section>

	<div class="sticky bottom-4 mt-4 flex flex-wrap items-center gap-3 rounded-md border border-line-strong bg-panel/95 p-3 shadow-2xl shadow-black/40 backdrop-blur">
		<button id="save" type="button" class="btn btn-primary">Save and open the dashboard</button>
		<span id="status" class="text-[13px] text-muted"></span>
	</div>
</App>

<script>
	import { api, requireUser, type Portfolio, type Position } from "../lib/api";
	import { add, h } from "../lib/dom";
	import { link } from "../lib/site";

	const MAX = 50;
	const rows = document.getElementById("rows")!;
	const noRows = document.getElementById("no-rows")!;
	const chips = document.getElementById("chips")!;
	const noChips = document.getElementById("no-chips")!;
	const status = document.getElementById("status")!;
	const save = document.getElementById("save") as HTMLButtonElement;
	let positions: (Position & { name?: string })[] = [];
	let watchlist: string[] = [];
	let dirty = false;

	const say = (text: string, error = false) => {
		status.textContent = text;
		status.className = `text-[13px] ${error ? "text-down" : "text-muted"}`;
	};
	const changed = () => ((dirty = true), say("Unsaved changes."));

	function numberField(value: number | null, placeholder: string, onInput: (v: number | null) => void) {
		const input = h("input", "field text-right") as HTMLInputElement;
		input.style.width = "6.5rem";
		input.type = "number";
		input.min = "0";
		input.step = "any";
		input.inputMode = "decimal";
		input.placeholder = placeholder;
		if (value !== null) input.value = String(value);
		input.addEventListener("input", () => (onInput(input.value === "" ? null : Number(input.value)), changed()));
		return input;
	}

	function drawRows() {
		rows.replaceChildren(...positions.map((p, i) => {
			const remove = h("button", "rounded px-2 py-1 text-lg leading-none text-muted hover:bg-raised hover:text-ink-strong", "×");
			remove.type = "button";
			remove.setAttribute("aria-label", `Remove ${p.ticker}`);
			remove.addEventListener("click", () => (positions.splice(i, 1), drawRows(), changed()));
			return add(h("tr"),
				add(h("td"), h("div", "font-semibold text-ink-strong", p.ticker), p.name ? h("div", "max-w-[12rem] truncate text-[11px] text-muted", p.name) : null),
				add(h("td"), numberField(p.shares || null, "0", (v) => (p.shares = v ?? 0))),
				add(h("td"), numberField(p.avg_cost, "optional", (v) => (p.avg_cost = v))),
				add(h("td"), remove));
		}));
		noRows.hidden = positions.length > 0;
	}

	function drawChips() {
		chips.replaceChildren(...watchlist.map((t) => {
			const x = h("button", "rounded px-1.5 text-muted hover:bg-line-strong hover:text-ink-strong", "×");
			x.type = "button";
			x.setAttribute("aria-label", `Remove ${t}`);
			x.addEventListener("click", () => ((watchlist = watchlist.filter((u) => u !== t)), drawChips(), changed()));
			return add(h("span", "inline-flex items-center gap-1 rounded border border-line-strong bg-raised py-1 pl-2.5 pr-1 text-[13px] font-semibold text-ink-strong"), t, x);
		}));
		noChips.hidden = watchlist.length > 0;
	}

	document.getElementById("add-position")!.addEventListener("pick", (e) => {
		const { ticker, name } = (e as CustomEvent<{ ticker: string; name: string }>).detail;
		if (positions.some((p) => p.ticker === ticker)) return say(`${ticker} is already in your positions.`);
		if (positions.length >= MAX) return say(`Up to ${MAX} positions.`, true);
		positions.push({ ticker, name, shares: 0, avg_cost: null });
		watchlist = watchlist.filter((t) => t !== ticker);
		drawRows();
		drawChips();
		changed();
		(rows.lastElementChild?.querySelector("input") as HTMLInputElement | null)?.focus();
	});
	document.getElementById("add-favourite")!.addEventListener("pick", (e) => {
		const { ticker } = (e as CustomEvent<{ ticker: string }>).detail;
		if (positions.some((p) => p.ticker === ticker)) return say(`${ticker} is in your positions, so it is tracked already.`);
		if (watchlist.includes(ticker)) return;
		if (watchlist.length >= MAX) return say(`Up to ${MAX} stocks in the watchlist.`, true);
		watchlist.push(ticker);
		drawChips();
		changed();
	});

	save.addEventListener("click", async () => {
		const missing = positions.find((p) => !(p.shares > 0));
		if (missing) return say(`Enter the number of shares of ${missing.ticker}.`, true);
		if (!positions.length && !watchlist.length) return say("Add at least one position or one stock to follow.", true);
		save.disabled = true;
		say("Saving…");
		try {
			await api<Portfolio>("/api/portfolio", {
				method: "PUT",
				body: JSON.stringify({ positions: positions.map(({ ticker, shares, avg_cost }) => ({ ticker, shares, avg_cost })), watchlist }),
			});
			dirty = false;
			location.href = link("/dashboard/");
		} catch (e) {
			save.disabled = false;
			say(e instanceof Error ? e.message : "Saving failed.", true);
		}
	});
	window.addEventListener("beforeunload", (e) => dirty && e.preventDefault());

	async function start() {
		await requireUser();
		const p = await api<Portfolio>("/api/portfolio");
		positions = p.positions;
		watchlist = p.watchlist;
		drawRows();
		drawChips();
		const welcome = new URLSearchParams(location.search).has("welcome") && !positions.length && !watchlist.length;
		if (welcome) {
			document.getElementById("welcome")!.hidden = false;
			document.getElementById("heading")!.hidden = true;
			for (const b of document.querySelectorAll<HTMLButtonElement>("[data-go]")) {
				b.addEventListener("click", () => {
					const target = document.getElementById(b.dataset.go!)!;
					target.scrollIntoView({ behavior: "smooth", block: "start" });
					target.querySelector("input")?.focus();
				});
			}
		}
	}
	start().catch(() => {});
</script>
