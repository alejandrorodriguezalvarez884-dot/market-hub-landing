---
// News: what companies filed, what the agencies published and what the market did, by day, with
// the press's headlines beside it. The page asks for a refresh when what is stored is stale.
import Site from "../components/Site.astro";
---

<Site title="News" description="What US companies filed with the SEC, what the Federal Reserve and the statistics agencies published, and what the market did. Written from the documents, each with its source. No advice.">
	<section class="grid gap-x-14 gap-y-4 lg:grid-cols-[minmax(0,7fr)_minmax(0,4fr)] lg:items-end">
		<div>
			<h1 class="text-[2rem] font-medium leading-tight tracking-tight text-ink-strong">News</h1>
			<p class="mt-2 max-w-xl text-ink">
				What companies filed, what the agencies published and what the market did. Written from the documents, and every
				item links to its source.
			</p>
		</div>
		<p id="news-status" class="text-[13px] text-muted lg:text-right" aria-live="polite">&nbsp;</p>
	</section>

	<div class="mt-10 grid gap-x-14 gap-y-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,4fr)] lg:items-start">
		<section class="sec" aria-label="News">
			<nav id="news-tabs" class="tabs mb-5" aria-label="Kind of news"></nav>
			<div id="news-list"><div class="skeleton h-24"></div><div class="skeleton mt-4 h-24"></div><div class="skeleton mt-4 h-24"></div></div>
		</section>

		<aside class="min-w-0 space-y-12">
			<section id="press" class="sec" aria-labelledby="press-title" hidden>
				<div class="sec-head">
					<h2 id="press-title" class="sec-title">In the press</h2>
					<span class="sec-note">Headlines only. Each opens at its publisher</span>
				</div>
				<div id="press-list"></div>
			</section>

			<section class="sec" aria-labelledby="how-title">
				<div class="sec-head"><h2 id="how-title" class="sec-title">How this page is made</h2></div>
				<div class="space-y-3 text-sm text-muted">
					<p>
						Company items come from the Form 8-K filings of the largest US-listed companies, the form a company files
						with the SEC when something material happens. Economy items come from the Federal Reserve, the Bureau of Labor
						Statistics and the Bureau of Economic Analysis.
					</p>
					<p>
						An AI model writes the title and the summary of a filing from the document itself, and the item links to it.
						Those items say so. Market items are written by code from the day's figures.
					</p>
					<p>Market Hub describes. Nothing here is a recommendation to buy or sell anything.</p>
				</div>
			</section>
		</aside>
	</div>
</Site>

<script>
	import { add, h } from "../lib/dom";
	import { timeAgo } from "../lib/format";
	import { news, watchNews, type News } from "../lib/market";
	import { byDay, newsLine } from "../lib/news";
	import { failed } from "../lib/widgets";

	const $ = (id: string) => document.getElementById(id)!;
	let chosen = "";

	function list(n: News, refreshing: boolean) {
		const items = chosen ? n.items.filter((i) => i.category === chosen) : n.items;
		if (items.length) return $("news-list").replaceChildren(...byDay(items));
		failed($("news-list"), refreshing ? "Reading the sources. This takes a few seconds the first time."
			: chosen ? `No ${chosen.toLowerCase()} items in the last days.` : "No news to show yet.");
	}

	function tabs(n: News, refreshing: boolean) {
		$("news-tabs").replaceChildren(...["", ...n.categories].map((c) => {
			const b = h("button", "tab-btn", c || "All");
			b.type = "button";
			b.setAttribute("aria-selected", String(c === chosen));
			b.addEventListener("click", () => {
				chosen = c;
				tabs(n, refreshing);
				list(n, refreshing);
			});
			return b;
		}));
	}

	function status(n: News, refreshing: boolean) {
		const el = $("news-status");
		if (n.sample) {
			el.replaceChildren(add(h("span", "text-warn"), "Sample headlines: placeholders, not news"));
		} else {
			el.textContent = refreshing ? "Reading the sources…" : n.refreshed_utc ? `Sources read ${timeAgo(n.refreshed_utc)}` : "";
		}
	}

	function draw(n: News, refreshing: boolean) {
		status(n, refreshing);
		tabs(n, refreshing);
		list(n, refreshing);
		$("press").hidden = !n.press.length;
		$("press-list").replaceChildren(...n.press.slice(0, 14).map(newsLine));
	}

	watchNews(() => news({ limit: 100 }), draw).catch(() => failed($("news-list"), "The news is not available right now."));
</script>
