---
// News: what companies filed, what the agencies published and what the market did, by day, with
// the press's headlines beside it. The page asks for a refresh when what is stored is stale.
import Site from "../components/Site.astro";
---

<Site title="News" description="What US companies filed with the SEC, what the Federal Reserve and the statistics agencies published, and what the market did. No advice.">
	<section class="grid gap-x-14 gap-y-4 lg:grid-cols-[minmax(0,7fr)_minmax(0,4fr)] lg:items-end">
		<div>
			<h1 class="text-[2rem] font-medium leading-tight tracking-tight text-ink-strong">News</h1>
			<p class="mt-2 max-w-xl text-ink">What companies filed, what the agencies published and what the market did.</p>
		</div>
		<p id="news-status" class="text-[13px] text-muted lg:text-right" aria-live="polite">&nbsp;</p>
	</section>

	<div class="mt-10 grid gap-x-14 gap-y-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,4fr)] lg:items-start">
		<section class="sec" aria-label="News">
			<nav id="news-tabs" class="tabs" aria-label="Kind of news"></nav>
			<div id="news-filters" class="mb-5 mt-3 flex min-h-[30px] flex-wrap items-center gap-x-2 gap-y-2" role="group" aria-label="Filter the news"></div>
			<div id="news-list"><div class="skeleton h-24"></div><div class="skeleton mt-4 h-24"></div><div class="skeleton mt-4 h-24"></div></div>
		</section>

		<aside class="min-w-0 space-y-12">
			<section id="press" class="sec" aria-labelledby="press-title" hidden>
				<div class="sec-head"><h2 id="press-title" class="sec-title">In the press</h2></div>
				<div id="press-list"></div>
			</section>
		</aside>
	</div>
</Site>

<script>
	import { add, h, svg } from "../lib/dom";
	import { timeAgo } from "../lib/format";
	import { news, watchNews, type News, type NewsItem } from "../lib/market";
	import { byDay, dayKey, dayLabel, newsLine, SENTIMENTS, toneMark, type Sentiment } from "../lib/news";
	import { failed } from "../lib/widgets";

	const $ = (id: string) => document.getElementById(id)!;

	// What the reader chose: the kind of news (the tabs), the sector it touches, how it reads and
	// its day. Empty is "any". The choice lives in the address, so coming back from an article, or
	// sharing the page, keeps it. An item nobody gave a sector or a reading is in no such filter.
	const KEYS = ["kind", "sector", "sentiment", "day"] as const;
	type Key = (typeof KEYS)[number];
	const valid: Record<Key, (v: string) => boolean> = {
		kind: (v) => v.length <= 30,
		sector: (v) => v.length <= 40,
		sentiment: (v) => SENTIMENTS.includes(v as Sentiment),
		day: (v) => /^\d{4}-\d{2}-\d{2}$/.test(v),
	};
	const valueOf: Record<Key, (i: NewsItem) => string> = {
		kind: (i) => i.category,
		sector: (i) => i.scope ?? "",
		sentiment: (i) => i.sentiment ?? "",
		day: (i) => dayKey(i.published_utc),
	};
	const asked = new URLSearchParams(location.search);
	const chosen = Object.fromEntries(KEYS.map((k) => [k, asked.get(k) ?? ""]).map(([k, v]) => [k, valid[k as Key](v) ? v : ""])) as Record<Key, string>;
	const filtering = () => KEYS.some((k) => chosen[k]);

	function remember() {
		const q = new URLSearchParams(KEYS.filter((k) => chosen[k]).map((k) => [k, chosen[k]])).toString();
		history.replaceState(null, "", location.pathname + (q ? `?${q}` : ""));
	}

	function choose(n: News, refreshing: boolean, changes: Partial<Record<Key, string>>) {
		Object.assign(chosen, changes);
		remember();
		tabs(n, refreshing);
		filters(n, refreshing);
		list(n, refreshing);
	}

	const shown = (n: News) => n.items.filter((i) => KEYS.every((k) => !chosen[k] || valueOf[k](i) === chosen[k]));

	function list(n: News, refreshing: boolean) {
		const items = shown(n);
		if (items.length) return $("news-list").replaceChildren(...byDay(items));
		failed($("news-list"), refreshing ? "Loading the news…" : filtering() ? "No news matches these filters." : "No news to show yet.");
	}

	function tabs(n: News, refreshing: boolean) {
		if (!n.categories.includes(chosen.kind)) chosen.kind = "";
		$("news-tabs").replaceChildren(...["", ...n.categories].map((c) => {
			const b = h("button", "tab-btn", c || "All");
			b.type = "button";
			b.setAttribute("aria-selected", String(c === chosen.kind));
			b.addEventListener("click", () => choose(n, refreshing, { kind: c }));
			return b;
		}));
	}

	// The menus of the filters are the page's own, drawn like its other menus: a browser's select
	// opens a list in the system's colours. One is open at a time; a click elsewhere closes it.
	const menus = () => document.querySelectorAll<HTMLElement>("#news-filters [data-menu]");
	function shut(but?: Node | null) {
		for (const m of menus()) {
			if (but && m.contains(but)) continue;
			m.querySelector<HTMLElement>("[role=listbox]")!.hidden = true;
			m.querySelector("button")!.setAttribute("aria-expanded", "false");
		}
	}
	document.addEventListener("click", (e) => shut(e.target as Node));

	// How it reads is chosen by its own mark, the one each item carries: pressing one filters by
	// it, pressing it again lets go. A sector and a day are a menu each: one is offered when some
	// item has it, and one asked for in the address and no longer there stays in its menu, so the
	// reader sees what is filtering.
	function filters(n: News, refreshing: boolean) {
		const present = (k: Key) => [...new Set([...n.items.map(valueOf[k]), chosen[k]].filter(Boolean))];
		const menu = (k: Key, label: string, options: string[][]) => {
			const all = [["", `Any ${label.toLowerCase()}`], ...options];
			const on = Boolean(chosen[k]);
			const box = h("div", "relative");
			box.dataset.menu = k;
			const arrow = svg("svg", { viewBox: "0 0 10 6", class: "h-1.5 w-2.5 flex-none", fill: "none", stroke: "currentColor", "stroke-width": 1.5, "stroke-linecap": "round", "stroke-linejoin": "round", "aria-hidden": "true" });
			arrow.append(svg("path", { d: "M1 1l4 4 4-4" }));
			const button = add(h("button", `inline-flex items-center gap-2 rounded-[3px] border px-2 py-1 text-[13px] ${on ? "border-ink-strong bg-raised text-ink-strong" : "border-line-strong text-muted hover:border-muted hover:text-ink-strong"}`),
				all.find(([value]) => value === chosen[k])![1], arrow);
			button.type = "button";
			button.setAttribute("aria-haspopup", "listbox");
			button.setAttribute("aria-expanded", "false");
			const list = h("div", "absolute left-0 top-full z-40 mt-1 max-h-80 min-w-full overflow-y-auto whitespace-nowrap rounded-[3px] border border-line-strong bg-panel p-1.5 shadow-2xl shadow-black/60");
			list.setAttribute("role", "listbox");
			list.setAttribute("aria-label", label);
			list.hidden = true;
			for (const [value, text] of all) {
				const o = h("button", `block w-full rounded px-3 py-1.5 text-left text-[13px] hover:bg-raised focus-visible:bg-raised ${value === chosen[k] ? "text-ink-strong" : "text-ink"}`, text);
				o.type = "button";
				o.setAttribute("role", "option");
				o.setAttribute("aria-selected", String(value === chosen[k]));
				o.addEventListener("click", () => {
					choose(n, refreshing, { [k]: value });
					document.querySelector<HTMLElement>(`#news-filters [data-menu="${k}"] button`)?.focus();
				});
				list.append(o);
			}
			const open = (yes: boolean) => {
				shut();
				list.hidden = !yes;
				button.setAttribute("aria-expanded", String(yes));
			};
			button.addEventListener("click", () => open(Boolean(list.hidden)));
			// Down and up walk the options, and Escape closes the menu and gives the focus back.
			box.addEventListener("keydown", (e) => {
				const step = e.key === "ArrowDown" ? 1 : e.key === "ArrowUp" ? -1 : 0;
				if (e.key === "Escape" && !list.hidden) {
					open(false);
					button.focus();
				}
				if (!step) return;
				e.preventDefault();
				if (list.hidden) open(true);
				const items = [...list.children] as HTMLElement[];
				const at = items.indexOf(document.activeElement as HTMLElement);
				items[at < 0 ? Math.max(0, all.findIndex(([value]) => value === chosen[k])) : (at + step + items.length) % items.length].focus();
			});
			return add(box, button, list);
		};
		const mark = (v: Sentiment) => {
			const on = chosen.sentiment === v;
			const b = add(h("button", `rounded-[3px] border px-2 py-1 text-[13px] ${on ? "border-ink-strong bg-raised" : "border-line-strong hover:border-muted"}`), toneMark(v));
			b.type = "button";
			b.setAttribute("aria-pressed", String(on));
			b.addEventListener("click", () => choose(n, refreshing, { sentiment: on ? "" : v }));
			return b;
		};
		const marks = add(h("div", "flex gap-1.5"), ...SENTIMENTS.map(mark));
		marks.setAttribute("role", "group");
		marks.setAttribute("aria-label", "Sentiment");
		const clear = h("button", "tab-btn ml-1", "Clear filters");
		clear.type = "button";
		clear.addEventListener("click", () => choose(n, refreshing, { kind: "", sector: "", sentiment: "", day: "" }));
		$("news-filters").replaceChildren(
			marks,
			menu("sector", "Sector", present("sector").sort((a, b) => Number(a === "Macro") - Number(b === "Macro") || a.localeCompare(b)).map((v) => [v, v])),
			menu("day", "Day", present("day").sort().reverse().map((v) => [v, dayLabel(`${v}T12:00:00`)])),
			...(filtering() ? [clear, h("span", "num ml-auto text-[12.5px] text-muted", `${shown(n).length} of ${n.items.length}`)] : []),
		);
	}

	function status(n: News, refreshing: boolean) {
		const el = $("news-status");
		if (n.sample) {
			el.replaceChildren(add(h("span", "text-warn"), "Sample headlines: placeholders, not news"));
		} else {
			el.textContent = refreshing ? "Updating…" : n.refreshed_utc ? `Updated ${timeAgo(n.refreshed_utc)}` : "";
		}
	}

	function draw(n: News, refreshing: boolean) {
		status(n, refreshing);
		tabs(n, refreshing);
		filters(n, refreshing);
		list(n, refreshing);
		$("press").hidden = !n.press.length;
		$("press-list").replaceChildren(...n.press.slice(0, 14).map(newsLine));
	}

	watchNews(() => news({ limit: 200 }), draw).catch(() => failed($("news-list"), "The news is not available right now."));
</script>
