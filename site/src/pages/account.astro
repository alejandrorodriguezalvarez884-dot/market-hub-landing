---
import App from "../components/App.astro";
---

<App title="Account" description="Your account and your data.">
	<p class="label">My Hub</p>
	<h1 class="mt-1 text-2xl font-bold text-ink-strong">Account and data</h1>
	<div id="account-page" class="mt-6 max-w-2xl space-y-4"></div>
</App>

<script>
	import { api, requireUser, type Portfolio } from "../lib/api";
	import type { Entry } from "../lib/competition";
	import { articleHref, submissions, type Submission } from "../lib/opinion";
	import type { Sharing } from "../lib/types";
	import { add, card, h } from "../lib/dom";
	import { link } from "../lib/site";

	const root = document.getElementById("account-page")!;

	async function start() {
		const who = await requireUser();
		const p = await api<Portfolio>("/api/portfolio");
		const mine = await api<{ comments: { slug: string; text: string; created_utc: string }[] }>("/api/opinion/mine").catch(() => ({ comments: [] }));
		const shared = await api<Sharing>("/api/sharing").catch(() => ({ enabled: false, handle: "", since_utc: null }));
		const played = await api<{ entries: Entry[] }>("/api/competitions/mine").catch(() => ({ entries: [] }));
		const sent = await submissions().catch(() => ({ articles: [] as Submission[] }));
		const month = (m: string) => new Date(`${m}-01T00:00:00Z`).toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "UTC" });
		const own = who.user.provider === "password";
		const info = card("What we keep", "Everything stored about you, as saved now");
		add(info.body, add(h("dl", "grid grid-cols-[8rem_1fr] gap-y-2 text-[13px]"),
			h("dt", "text-muted", "Name"), h("dd", "text-ink-strong", who.user.name),
			h("dt", "text-muted", "Email"), h("dd", "text-ink-strong", who.user.email),
			h("dt", "text-muted", "Sign-in"), h("dd", "text-ink-strong", own ? "With this email and a password. We keep the password scrambled, never as you typed it." : "With Google. We keep no password."),
			h("dt", "text-muted", "Positions"), h("dd", "text-ink-strong", p.positions.map((x) => `${x.ticker} (${x.shares})`).join(", ") || "None"),
			h("dt", "text-muted", "Watchlist"), h("dd", "text-ink-strong", p.watchlist.join(", ") || "None"),
			h("dt", "text-muted", "Shared portfolio"), add(h("dd", "text-ink-strong"), shared.enabled ? `Shared as "${shared.handle}": your tickers and their weights, to signed-in members. ` : "Not shared. ",
				Object.assign(h("a", "link", shared.enabled ? "Change it" : "About sharing"), { href: link("/community/") })),
			h("dt", "text-muted", "Competition"), add(h("dd", "text-ink-strong"), played.entries.length
				? add(h("ul", "space-y-1"), ...played.entries.slice(0, 12).map((e) => h("li", "", `${month(e.month)}, as "${e.handle}": ${e.picks.map((p) => `${p.ticker} ${p.weight}%`).join(", ")}`)))
				: "No entries. ", played.entries.length ? null : Object.assign(h("a", "link", "About the competition"), { href: link("/community/competitions/") })),
			h("dt", "text-muted", "Comments"), h("dd", "text-ink-strong", mine.comments.length
				? `${mine.comments.length}: under articles they are public, with your first name; in the competition members see them, with the name you play under` : "None"),
			h("dt", "text-muted", "Articles sent in"), add(h("dd", "text-ink-strong"), sent.articles.length
				? `${sent.articles.length}, kept for the editor to review with your name and email: ${sent.articles.map((a) => `"${a.title}"`).join(", ")}. ` : "None. ",
				Object.assign(h("a", "link", sent.articles.length ? "See them or take one back" : "Write for Opinion"), { href: link("/opinion/submit/") })),
		));
		if (mine.comments.length) add(info.body, add(h("ul", "mt-3 space-y-1.5 text-[13px]"), ...mine.comments.slice(0, 20).map((c) => {
			const a = h("a", "link", c.text.length > 80 ? `${c.text.slice(0, 80)}…` : c.text) as HTMLAnchorElement;
			a.href = c.slug.startsWith("competition-") ? link("/community/competitions/") : articleHref(c.slug);
			return add(h("li", "truncate"), a);
		})));
		const download = h("button", "btn btn-ghost mt-4", "Download my data (JSON)");
		download.type = "button";
		download.addEventListener("click", () => {
			const blob = new Blob([JSON.stringify({ user: who.user, ...p, sharing: shared, competition: played.entries, comments: mine.comments, articles_sent: sent.articles }, null, 2)], { type: "application/json" });
			const a = h("a") as HTMLAnchorElement;
			a.href = URL.createObjectURL(blob);
			a.download = "market-hub-data.json";
			a.click();
			URL.revokeObjectURL(a.href);
		});
		info.body.append(download);

		// An account of ours can change its password: it takes the one it has now.
		const secret = card("Change your password", "It takes your current one. We cannot send you a new one if you forget it.");
		const field = (label: string, complete: string) => {
			const input = h("input", "field mt-1 w-full");
			Object.assign(input, { type: "password", autocomplete: complete, maxLength: 200, required: true });
			input.setAttribute("aria-label", label);
			return { row: add(h("label", "block"), h("span", "label", label), input), input };
		};
		const [now, next] = [field("Current password", "current-password"), field("New password, at least 10 characters", "new-password")];
		const change = h("button", "btn btn-ghost", "Change password");
		change.type = "submit";
		const said = h("p", "text-[13px]");
		said.setAttribute("role", "status");
		const form = add(h("form", "max-w-xs space-y-3"), now.row, next.row, change, said);
		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			change.disabled = true;
			try {
				await api("/api/auth/password", { method: "PUT", body: JSON.stringify({ current: now.input.value, new: next.input.value }) });
				form.reset();
				said.className = "text-[13px] text-up";
				said.textContent = "Changed. Other devices stay signed in until their session ends.";
			} catch (err) {
				said.className = "text-[13px] text-down";
				said.textContent = err instanceof Error ? err.message : "That did not work.";
			}
			change.disabled = false;
		});
		secret.body.append(form);

		const danger = card("Delete your account", "Removes your positions, watchlist and profile from our database at once, takes your portfolio off the community board, removes your entries to the competition, empties the comments you wrote and removes the articles you sent in for review. Signing in again later starts from zero.");
		const del = h("button", "btn btn-danger", "Delete my account");
		del.type = "button";
		const status = h("p", "mt-2 text-[13px] text-muted");
		del.addEventListener("click", async () => {
			if (!confirm("Delete your account and all your saved stocks? This cannot be undone.")) return;
			del.disabled = true;
			try {
				await api("/api/me", { method: "DELETE" });
				(window as any).google?.accounts?.id?.disableAutoSelect?.();
				location.href = link("/");
			} catch (e) {
				del.disabled = false;
				status.textContent = e instanceof Error ? e.message : "Deleting failed.";
			}
		});
		add(danger.body, del, status);
		root.replaceChildren(...(own ? [info.el, secret.el, danger.el] : [info.el, danger.el]));
	}
	start().catch(() => {});
</script>
