---
// My Hub, Watchlist: the stocks the user follows, side by side. Three ways of looking at them:
// a wall of charts that fills the window, several at a time; each stock's reading (where its price
// stands against its averages, its trend, its strength against the index and its sector's, what
// analysts estimate), as gauges with a sentence under each; and the whole list on one map.
// Which stocks, how many at a time and how they are drawn is kept in the browser, not on the server.
import App from "../components/App.astro";
import Search from "../components/Search.astro";
---

<App title="Watchlist" description="The stocks you follow, side by side: their charts and how each one stands." wide>
	<div id="watch-head"><div class="skeleton h-16 w-80"></div></div>
	<section id="watch-pick" class="panel mt-4 p-3 sm:p-4" hidden>
		<div class="flex flex-wrap items-start gap-x-8 gap-y-3">
			<div id="watch-chips" class="min-w-0 flex-1 space-y-2"></div>
			<div class="w-full sm:w-80">
				<p class="label mb-1.5">Look at any other stock</p>
				<Search mode="pick" button="Look" id="watch-add" />
			</div>
		</div>
		<p id="watch-say" class="mt-2 text-[12.5px] text-muted" hidden></p>
	</section>
	<div id="watch-bar" class="mt-4 flex flex-wrap items-center gap-x-7 gap-y-2" hidden></div>
	<div id="watch-stage" class="mt-3"><div class="skeleton h-[420px]"></div></div>

	<div id="watch-drawer" class="fixed inset-0 z-50" hidden>
		<div data-close class="absolute inset-0 bg-black/60"></div>
		<aside role="dialog" aria-modal="true" aria-label="A stock's reading"
			class="absolute right-0 top-0 flex h-full w-full max-w-[680px] flex-col overflow-y-auto border-l border-line-strong bg-page p-4 shadow-2xl shadow-black sm:p-6"></aside>
	</div>
</App>

<script>
	import { api, requireUser, type Portfolio } from "../lib/api";
	import { add, h, linkTo } from "../lib/dom";
	import { failure, pageHead } from "../lib/hub";
	import { link } from "../lib/site";
	import { sparkline } from "../lib/spark";
	import { asOf, getBars, getBoard, getStock, listMap, listTable, readingCard, stateMarks, stockHead, type Board, type Item } from "../lib/watch";
	import { averagesKey, chartCredit, RANGES, tileChart, type ChartLook, type Range, type TileChart } from "../lib/watchcharts";

	const head = document.getElementById("watch-head")!;
	const pick = document.getElementById("watch-pick")!;
	const chips = document.getElementById("watch-chips")!;
	const note = document.getElementById("watch-say")!;
	const bar = document.getElementById("watch-bar")!;
	const stage = document.getElementById("watch-stage")!;
	const drawer = document.getElementById("watch-drawer")!;
	const sheet = drawer.querySelector("aside")!;

	const VIEWS = [["charts", "Charts"], ["readings", "Readings"], ["map", "Map"]] as const;
	type View = (typeof VIEWS)[number][0];
	const PER = [1, 2, 3, 4, 6, 9, 12];
	const OTHERS = 20; // stocks looked at that are on neither list
	const WATCHLIST = 50;

	// --- What the reader chose, kept in this browser -------------------------------------------------

	type Chosen = ChartLook & { view: View; per: number; others: string[]; picked: Record<string, boolean> };
	const KEY = "mh.watchlist.v1";
	function restore(): Chosen {
		const first: Chosen = { view: "charts", per: innerWidth < 640 ? 2 : 6, range: "1Y", style: "candles", averages: true, others: [], picked: {} };
		try {
			const got = JSON.parse(localStorage.getItem(KEY) ?? "{}");
			return {
				view: VIEWS.some(([v]) => v === got.view) ? got.view : first.view,
				per: PER.includes(got.per) ? got.per : first.per,
				range: got.range in RANGES ? got.range : first.range,
				style: got.style === "area" ? "area" : "candles",
				averages: got.averages !== false,
				others: Array.isArray(got.others) ? got.others.filter((t: unknown) => typeof t === "string").slice(0, OTHERS) : [],
				picked: got.picked && typeof got.picked === "object" ? got.picked : {},
			};
		} catch {
			return first;
		}
	}
	const s = restore();
	const keep = () => {
		try {
			localStorage.setItem(KEY, JSON.stringify(s));
		} catch {
			// a browser that keeps nothing: the choices last for this visit
		}
	};

	let board: Board;
	const items = new Map<string, Item>();
	let page = 0;
	let charts: TileChart[] = [];
	let unlay: (() => void) | null = null;

	const held = () => board.positions.filter((t) => !board.watchlist.includes(t));
	const order = () => [...board.watchlist, ...s.others, ...held()];
	// What is followed and what was looked up is shown until it is turned off; what is held, once it is turned on.
	const on = (t: string) => s.picked[t] ?? (board.watchlist.includes(t) || s.others.includes(t) || (!board.watchlist.length && !s.others.length));
	const chosen = () => order().filter(on).map((t) => items.get(t)).filter((i): i is Item => !!i);
	const look = (): ChartLook => ({ range: s.range, style: s.style, averages: s.averages });

	function say(text: string, error = false) {
		note.textContent = text;
		note.hidden = !text;
		note.className = `mt-2 text-[12.5px] ${error ? "text-down" : "text-muted"}`;
	}
	function button(cls: string, text: string, onClick: () => void): HTMLButtonElement {
		const b = h("button", cls, text);
		b.type = "button";
		b.addEventListener("click", onClick);
		return b;
	}
	function tabs<T extends string | number>(label: string, options: readonly (readonly [T, string])[], current: T, choose: (v: T) => void): HTMLElement {
		const list = h("div", "tabs");
		list.setAttribute("role", "tablist");
		list.setAttribute("aria-label", label);
		for (const [value, text] of options) {
			const b = button("tab-btn", text, () => choose(value));
			b.setAttribute("role", "tab");
			b.setAttribute("aria-selected", String(value === current));
			list.append(b);
		}
		return add(h("div", "flex items-center gap-2.5"), h("span", "text-[12.5px] text-faint", label), list);
	}

	// --- Which stocks ---------------------------------------------------------------------------------

	function drawChips() {
		const chip = (t: string) => {
			const b = button("wl-chip", t, () => {
				s.picked[t] = !on(t);
				page = 0;
				keep();
				draw();
			});
			b.setAttribute("aria-pressed", String(on(t)));
			b.title = items.get(t)?.name ?? t;
			return b;
		};
		const group = (title: string, tickers: string[], each: (t: string) => HTMLElement = chip) => {
			if (!tickers.length) return null;
			const all = (shown: boolean) => button("text-[12px] text-muted hover:text-ink-strong", shown ? "all" : "none", () => {
				for (const t of tickers) s.picked[t] = shown;
				page = 0;
				keep();
				draw();
			});
			return add(h("div", "flex flex-wrap items-center gap-1.5"), h("span", "label w-[5.2rem] flex-none", title), ...tickers.map(each),
				tickers.length > 1 ? add(h("span", "ml-1 flex gap-2"), all(true), all(false)) : null);
		};
		// A stock that is on neither list can be put on the watchlist from here, or let go.
		const other = (t: string) => add(h("span", "inline-flex items-center"), chip(t),
			Object.assign(button("px-1.5 text-[12px] text-muted hover:text-ink-strong", "follow", () => follow(t)), { title: `Add ${t} to your watchlist` }),
			Object.assign(button("pr-1 text-[15px] leading-none text-muted hover:text-ink-strong", "×", () => {
				s.others = s.others.filter((x) => x !== t);
				delete s.picked[t];
				keep();
				draw();
			}), { ariaLabel: `Stop looking at ${t}` }));
		chips.replaceChildren(...([group("Watchlist", board.watchlist), group("Also looking", s.others, other), group("Positions", held())].filter(Boolean) as HTMLElement[]));
		if (!chips.childElementCount) chips.append(add(h("p", "text-[13px] text-muted"), "You follow no stocks yet. ",
			linkTo(link("/portfolio/#watchlist"), "link", "Add stocks to your watchlist"), ", or look one up here."));
	}

	async function follow(t: string) {
		try {
			const p = await api<Portfolio>("/api/portfolio");
			if (p.watchlist.length >= WATCHLIST) return say(`Up to ${WATCHLIST} stocks in the watchlist.`, true);
			if (!p.watchlist.includes(t)) await api<Portfolio>("/api/portfolio", { method: "PUT", body: JSON.stringify({ positions: p.positions, watchlist: [...p.watchlist, t] }) });
			board.watchlist = [...new Set([...board.watchlist, t])];
			s.others = s.others.filter((x) => x !== t);
			keep();
			say(`${t} is on your watchlist.`);
			draw();
		} catch (e) {
			say(e instanceof Error ? e.message : "Saving failed.", true);
		}
	}

	document.getElementById("watch-add")!.addEventListener("pick", async (e) => {
		const t = (e as CustomEvent<{ ticker: string }>).detail.ticker.toUpperCase().replace(".", "-");
		const show = () => {
			s.picked[t] = true;
			page = Math.floor(Math.max(0, chosen().findIndex((i) => i.ticker === t)) / s.per);
			keep();
			say("");
			draw();
		};
		if (items.has(t)) {
			if (!order().includes(t)) s.others.push(t);
			return show();
		}
		if (s.others.length >= OTHERS) return say(`Up to ${OTHERS} stocks besides your lists. Let one go first.`, true);
		say(`Reading ${t}…`);
		try {
			items.set(t, (await getStock(t)).item);
			s.others.push(t);
			show();
		} catch (err) {
			say(err instanceof Error ? err.message : "That stock could not be read.", true);
		}
	});

	// --- How they are shown ---------------------------------------------------------------------------

	function drawBar(total: number) {
		const paged = s.view !== "map";
		const pages = Math.max(1, Math.ceil(total / s.per));
		const from = page * s.per;
		const set = <K extends keyof Chosen>(key: K, value: Chosen[K], redraw = true) => {
			s[key] = value;
			keep();
			if (redraw) draw();
			else (drawBar(total), charts.forEach((c) => c.look(look())));
		};
		const turn = (by: number) => ((page = Math.min(pages - 1, Math.max(0, page + by))), draw());
		const arrow = (text: string, by: number, label: string) => {
			const b = button("btn btn-ghost !px-2.5 !py-0.5", text, () => turn(by));
			b.disabled = by < 0 ? page === 0 : page >= pages - 1;
			b.setAttribute("aria-label", label);
			return b;
		};
		const averages = button("tab-btn", "Averages", () => set("averages", !s.averages, false));
		averages.setAttribute("aria-pressed", String(s.averages));
		averages.setAttribute("aria-selected", String(s.averages));
		bar.replaceChildren();
		add(bar,
			tabs("View", VIEWS, s.view, (v) => ((page = 0), set("view", v))),
			paged ? tabs("At a time", PER.map((n) => [n, String(n)] as const), s.per, (n) => ((page = 0), set("per", n))) : null,
			...(s.view === "charts" ? [
				tabs("Span", (Object.keys(RANGES) as Range[]).map((r) => [r, r] as const), s.range, (r) => set("range", r, false)),
				tabs("Draw", [["candles", "Candles"], ["area", "Line"]] as const, s.style, (v) => set("style", v, false)),
				add(h("div", "flex items-center gap-3"), averages, s.averages ? averagesKey() : null),
			] : []),
			add(h("div", "ml-auto flex items-center gap-2.5 text-[12.5px] text-muted"),
				h("span", "hidden sm:inline", asOf(board)),
				paged && total ? h("span", "num text-ink", `${from + 1}–${Math.min(total, from + s.per)} of ${total}`) : null,
				paged && pages > 1 ? arrow("‹", -1, "The stocks before") : null, paged && pages > 1 ? arrow("›", 1, "The next stocks") : null));
	}

	// The grid that shows `n` charts in a space of W by H with the tiles nearest the shape of a
	// chart. When the window is too small for them all, they keep a fair size and the page scrolls.
	function fit(n: number, W: number, H: number, gap = 12): { cols: number; h: number } {
		let best: { cols: number; h: number; score: number } | null = null;
		for (let cols = 1; cols <= n; cols++) {
			const rows = Math.ceil(n / cols);
			const w = (W - gap * (cols - 1)) / cols, tall = (H - gap * (rows - 1)) / rows;
			if (w < 300 || tall < 230) continue;
			const score = Math.abs(Math.log(w / tall / 1.7)) + (cols * rows - n) * 0.2;
			if (!best || score < best.score) best = { cols, h: tall, score };
		}
		return best ?? { cols: Math.max(1, Math.min(n, Math.floor((W + gap) / (340 + gap)))), h: 300 };
	}

	const message = (text: string) => h("p", "absolute inset-0 flex items-center justify-center px-4 text-center text-[13px] text-muted", text);

	function tile(item: Item): HTMLElement {
		const host = h("div", "relative min-h-0 flex-1");
		const el = add(h("article", "wl-tile"),
			add(h("header", "flex items-center gap-3 border-b border-line px-3 py-1.5"), stockHead(item, "flex-1"),
				item.reading ? button("wl-open", "Reading", () => open(item)) : null),
			add(h("div", "wl-marks"), ...stateMarks(item)), host);
		if (!item.reading) host.append(message(`No prices for ${item.ticker} right now.`));
		else {
			host.append(message("Loading…"));
			getBars(item.ticker)
				.then((bars) => el.isConnected && charts.push(tileChart(host, bars, look())))
				.catch(() => host.replaceChildren(message("The chart is not available right now.")));
		}
		return el;
	}

	function wall(list: Item[]) {
		const grid = add(h("div", "wl-wall"), ...list.map(tile));
		stage.replaceChildren(grid, chartCredit("mt-2"));
		const lay = () => {
			const room = innerHeight - (grid.getBoundingClientRect().top + scrollY) - 44;
			const f = fit(list.length, grid.clientWidth, Math.max(440, room));
			grid.style.gridTemplateColumns = `repeat(${f.cols}, minmax(0, 1fr))`;
			grid.style.gridAutoRows = `${Math.floor(f.h)}px`;
		};
		lay();
		addEventListener("resize", lay);
		unlay = () => removeEventListener("resize", lay);
	}

	function readings(list: Item[]) {
		stage.replaceChildren(add(h("div", "wl-readings"), ...list.map((item) => {
			const card = readingCard(item, board.benchmark.name);
			card.load();
			return add(h("article", "panel min-w-0 p-4 sm:p-5"),
				add(h("header", "mb-3 flex items-center gap-4"), add(h("div", "min-w-0 flex-1"), stockHead(item),
					item.sector ? h("p", "mt-0.5 truncate text-[12px] text-muted", [item.sector, item.industry].filter(Boolean).join(" · ")) : null),
					item.reading ? sparkline(item.reading.spark, 132, 34) : null),
				card.el);
		})));
	}

	function map(list: Item[]) {
		stage.replaceChildren(
			add(h("section", "panel p-3 sm:p-4"), listMap(list, board.benchmark.name, open)),
			add(h("section", "panel mt-4"), listTable(list, open)));
	}

	function draw() {
		for (const c of charts) c.remove();
		charts = [];
		unlay?.();
		unlay = null;
		drawChips();
		const list = chosen();
		page = Math.min(page, Math.max(0, Math.ceil(list.length / s.per) - 1));
		drawBar(list.length);
		if (!list.length) return stage.replaceChildren(add(h("div", "panel p-8 text-center"),
			h("p", "text-ink", order().length ? "No stock is chosen. Turn some on above." : "There is nothing to look at yet."),
			order().length ? null : add(h("p", "mt-4"), linkTo(link("/portfolio/#watchlist"), "btn btn-primary", "Add stocks to your watchlist"))));
		const shown = list.slice(page * s.per, (page + 1) * s.per);
		if (s.view === "charts") wall(shown);
		else if (s.view === "readings") readings(shown);
		else map(list);
	}

	// --- One stock, next to whatever is on the page ----------------------------------------------------

	let opened: TileChart | null = null;
	function close() {
		drawer.hidden = true;
		opened?.remove();
		opened = null;
		document.documentElement.style.overflow = "";
	}
	function open(item: Item) {
		close();
		const host = h("div", "relative mt-3 h-[230px] flex-none");
		const card = readingCard(item, board.benchmark.name);
		const shut = button("btn btn-ghost flex-none !px-2.5 !py-0.5", "Close", close);
		sheet.replaceChildren();
		add(sheet, add(h("div", "flex items-center gap-3"), stockHead(item, "flex-1 text-[15px]"), shut),
			item.sector ? h("p", "mt-0.5 text-[12px] text-muted", [item.sector, item.industry].filter(Boolean).join(" · ")) : null,
			host, chartCredit("mt-1"), add(h("div", "mt-4"), card.el));
		drawer.hidden = false;
		document.documentElement.style.overflow = "hidden";
		sheet.scrollTop = 0;
		shut.focus();
		card.load();
		getBars(item.ticker).then((bars) => !drawer.hidden && host.isConnected && (opened = tileChart(host, bars, look()))).catch(() => host.remove());
	}
	drawer.querySelector("[data-close]")!.addEventListener("click", close);
	addEventListener("keydown", (e) => {
		if (e.key === "Escape" && !drawer.hidden) return close();
		if (!drawer.hidden || s.view === "map" || (e.target as HTMLElement).closest?.("input, textarea, select") || e.metaKey || e.ctrlKey || e.altKey) return;
		if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
		const pages = Math.ceil(chosen().length / s.per);
		const next = Math.min(pages - 1, Math.max(0, page + (e.key === "ArrowRight" ? 1 : -1)));
		if (next !== page) ((page = next), draw());
	});

	async function start() {
		await requireUser();
		try {
			board = await getBoard();
			for (const item of board.items) items.set(item.ticker, item);
			// What was looked at on an earlier visit and is on neither list is read again.
			s.others = s.others.filter((t) => !items.has(t));
			const again = await Promise.all(s.others.map((t) => getStock(t).then((r) => r.item).catch(() => null)));
			s.others = s.others.filter((_, n) => again[n]);
			for (const item of again) if (item) items.set(item.ticker, item);
			head.replaceChildren(pageHead("Watchlist", "The stocks you follow, side by side: their charts, how each one stands, and all of them on one map.",
				{ sample: board.sample, action: linkTo(link("/portfolio/#watchlist"), "btn btn-ghost", "Edit watchlist") }));
			pick.hidden = bar.hidden = false;
			draw();
		} catch (e) {
			failure(stage, e);
		}
	}
	start().catch(() => {});
</script>

<style is:global>
	.wl-chip {
		display: inline-flex;
		align-items: center;
		border: 1px solid var(--color-line-strong);
		border-radius: 2px;
		background: var(--color-raised);
		padding: 1px 8px;
		font-family: var(--font-mono);
		font-size: 12.5px;
		color: var(--color-ink-strong);
	}
	.wl-chip:hover {
		border-color: var(--color-muted);
	}
	.wl-chip[aria-pressed="false"] {
		border-color: var(--color-line);
		background: transparent;
		color: var(--color-faint);
	}
	.wl-wall {
		display: grid;
		gap: 12px;
	}
	.wl-tile {
		display: flex;
		min-width: 0;
		min-height: 0;
		flex-direction: column;
		overflow: hidden;
		border: 1px solid var(--color-line);
		border-radius: 3px;
	}
	.wl-marks {
		display: flex;
		gap: 6px;
		overflow: hidden;
		padding: 6px 12px 2px;
	}
	.wl-state {
		display: inline-flex;
		flex: none;
		align-items: baseline;
		border: 1px solid var(--color-line-strong);
		border-radius: 2px;
		padding: 0 6px;
		font-size: 11.5px;
		line-height: 1.65;
		white-space: nowrap;
		color: var(--color-ink);
	}
	.wl-open {
		flex: none;
		border: 1px solid var(--color-line-strong);
		border-radius: 2px;
		padding: 0 8px;
		font-size: 12px;
		line-height: 1.7;
		color: var(--color-ink);
	}
	.wl-open:hover {
		border-color: var(--color-ink-strong);
		color: var(--color-ink-strong);
	}
	.wl-readings {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 620px), 1fr));
		align-items: start;
		gap: 12px;
	}
	.wl-card {
		min-width: 0;
		transition: opacity 0.25s;
	}
	.wl-headline {
		max-width: 44rem;
		font-size: 1.2rem;
		font-weight: 500;
		line-height: 1.3;
		letter-spacing: -0.01em;
		color: var(--color-ink-strong);
		text-wrap: pretty;
	}
	.wl-contrast {
		display: flex;
		gap: 8px;
		max-width: 44rem;
		margin-top: 10px;
		border-left: 2px solid var(--color-ink-strong);
		padding: 1px 0 1px 10px;
		font-size: 13.5px;
		color: var(--color-ink);
	}
	.wl-contrast[hidden] {
		display: none;
	}
	.wl-aspects {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
		gap: 0 28px;
		margin-top: 16px;
	}
	.wl-aspect {
		min-width: 0;
		border-top: 1px solid var(--color-line);
		padding: 12px 0 16px;
	}
	.wl-say {
		margin-top: 10px;
		font-size: 13.5px;
		line-height: 1.5;
		color: var(--color-ink);
		text-wrap: pretty;
	}
	/* A scale: a line, and marks at fractions of its length. */
	.wl-scale {
		position: relative;
		height: 18px;
	}
	.wl-scale::before {
		content: "";
		position: absolute;
		inset: 50% 0 auto 0;
		height: 1px;
		background: var(--color-line-strong);
	}
	.wl-band {
		position: absolute;
		top: calc(50% - 4px);
		height: 8px;
		border-radius: 1px;
		background: var(--color-line-strong);
	}
	.wl-tick {
		position: absolute;
		top: 2px;
		bottom: 2px;
		width: 2px;
		margin-left: -1px;
		background: var(--color-muted);
	}
	.wl-dot {
		position: absolute;
		top: 50%;
		z-index: 1;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: currentColor;
		box-shadow: 0 0 0 2px var(--color-page);
		color: var(--color-ink-strong);
		transform: translate(-50%, -50%);
	}
