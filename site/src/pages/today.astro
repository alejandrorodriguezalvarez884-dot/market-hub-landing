---
// Today: where the US market is in its day, one chart, every move of the day on one ruler, the
// sectors and the latest news.
import MarketSession from "../components/MarketSession.astro";
import Site from "../components/Site.astro";
import { link } from "../lib/site";
---

<Site title="Today" description="The market at a glance: indices, rates, commodities, currencies and sectors on one scale, with charts and the analysis tools of Market Hub.">
	<h1 class="sr-only">Today</h1>
	<MarketSession />

	<!-- Two columns on a wide screen; on a narrow one the blocks follow the order-N classes. -->
	<div class="mt-12 flex flex-col gap-x-14 gap-y-12 lg:mt-16 lg:grid lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-start">
		<div class="contents lg:block lg:space-y-12">
		<section class="sec order-1" aria-labelledby="chart-title">
			<div class="sec-head">
				<h2 id="chart-title" class="sec-title">&nbsp;</h2>
				<a id="chart-link" class="sec-note hover:text-ink-strong" hidden>Full page →</a>
			</div>
			<div id="chart-figure" class="mb-4 min-h-[44px]"><span class="skeleton block h-9 w-56"></span></div>
			<div id="main-chart" class="min-h-[480px]"></div>
		</section>

		<section class="sec order-3" aria-labelledby="sectors-title">
			<div class="sec-head">
				<h2 id="sectors-title" class="sec-title">US sectors</h2>
			</div>
			<div id="sectors" style="--track: 240px"><div class="skeleton h-72"></div></div>
		</section>
		</div>

		<div class="contents lg:block lg:space-y-12">
		<section class="sec order-2" aria-labelledby="ruler-title">
			<div class="sec-head">
				<h2 id="ruler-title" class="sec-title">Today, on one scale</h2>
				<span class="sec-note">Pick a row to chart it</span>
			</div>
			<div id="ruler" class="ruler"><div class="skeleton h-[420px]"></div></div>
		</section>

		<section id="latest" class="sec order-4" aria-labelledby="latest-title" hidden>
			<div class="sec-head">
				<h2 id="latest-title" class="sec-title">Latest news</h2>
				<a href={link("/news/")} class="sec-note hover:text-ink-strong">All news →</a>
			</div>
			<div id="latest-list"></div>
		</section>
		</div>
	</div>
</Site>

<script>
	import { add, h } from "../lib/dom";
	import { change, level, signedPct, toneClass } from "../lib/format";
	import { news, overview, watchNews, type Snapshot } from "../lib/market";
	import { newsLine } from "../lib/news";
	import { tvChart, type Chart } from "../lib/tv";
	import { failed, flagSample, quoteHref, rateItem, rulerAxis, rulerGroup, rulerRow, rulerScale, sectorRuler, snapshotItem } from "../lib/widgets";

	const $ = (id: string) => document.getElementById(id)!;
	let chart: Chart | null = null;

	// The instrument in the chart: its name, level and move above it, its row marked on the ruler.
	function pick(s: Snapshot) {
		$("chart-title").textContent = s.name;
		$("chart-figure").replaceChildren(add(h("div", "flex flex-wrap items-baseline gap-x-4"),
			h("span", "num text-[2rem] leading-none text-ink-strong", level(s.price, s.kind)),
			h("span", `num ${toneClass(s.change_pct)}`, `${change(s.change, s.kind)} (${signedPct(s.change_pct, 2)})`),
			h("span", "text-[13px] text-muted", "today")));
		const a = $("chart-link") as HTMLAnchorElement;
		a.href = quoteHref(s.symbol);
		a.hidden = false;
		document.querySelectorAll<HTMLElement>("#ruler [data-key]").forEach((r) => r.setAttribute("aria-pressed", String(r.dataset.key === s.symbol)));
		if (chart) chart.setSymbol(s.symbol);
		else chart = tvChart($("main-chart"), { symbol: s.symbol, range: "1D", height: 480 });
	}

	// The newest items, when there are any that are not placeholders. The block stays out otherwise.
	watchNews(() => news({ limit: 6 }), (n) => {
		$("latest").hidden = n.sample || !n.items.length;
		$("latest-list").replaceChildren(...n.items.map(newsLine));
	}).catch(() => {});

	overview()
		.then((o) => {
			const onPick = (s: Snapshot) => pick(s);

			const charted = [...o.indices, ...o.commodities, ...o.currencies, ...o.crypto];
			const scale = rulerScale(charted.map((s) => s.change_pct));
			const rows = (items: Snapshot[]) => items.map((s) => rulerRow(snapshotItem(s, onPick), scale));
			$("ruler").replaceChildren(
				add(h("div", "ruler-row !py-0"), h("span"), h("span", "hidden sm:block"), rulerAxis(scale), h("span")),
				...rulerGroup("Stock indices", rows(o.indices)),
				...rulerGroup("Treasury yields", o.rates.map((s) => rulerRow(rateItem(s), scale))),
				...rulerGroup("Commodities", rows(o.commodities)),
				...rulerGroup("Currencies", rows(o.currencies)),
				...rulerGroup("Crypto", rows(o.crypto)));
			$("sectors").replaceChildren(sectorRuler(o.sectors));
			pick(o.indices.find((s) => s.symbol === "SPX") ?? charted[0]);

			flagSample(o, ["indices", "rates", "commodities", "currencies", "crypto"], $("ruler-title"));
			flagSample(o, ["sectors"], $("sectors-title"));
		})
		.catch(() => {
			for (const id of ["chart-figure", "ruler", "sectors"]) failed($(id));
		});
</script>
