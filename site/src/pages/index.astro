---
// The landing page: what Market Hub is, a film about it, and each of its parts with the way in. It
// asks the data provider for nothing, so a visit to it costs no market-data calls. The film is
// drawn and scored by code (film/, `make film`); it is no recording of the site.
import Site from "../components/Site.astro";
import { FUNDAMENTALS_URL, RADAR_URL, SITE_NAME, link } from "../lib/site";

const parts = [
	{
		name: "Today",
		title: "Every move of the day, on one scale",
		text: "The page opens with a sentence written from the figures. Under it, stock indices, yields, commodities, currencies and crypto share one ruler: left is down, right is up, and the length is the size of the move. Pick a row to chart it.",
		href: link("/today/"),
		cta: "Open Today",
		shot: "today",
	},
	{
		name: "Markets",
		title: "The tables behind it",
		text: "Each market with its level, the day's move and its return over a month, the year so far and twelve months. Then the eleven US sectors, and the stocks that moved and traded the most.",
		href: link("/markets/"),
		cta: "Open Markets",
		shot: "markets",
	},
	{
		name: "Fundamentals Lab",
		title: "Every number of a company, on one page",
		text: "Statements, margins and returns on capital. Valuation against the company's own history. The multiples the stock would trade at if the analysts' consensus is met. The technical picture, and up to five companies side by side. An AI reading says what the numbers show.",
		href: `${FUNDAMENTALS_URL}/`,
		cta: "Open Fundamentals",
		shot: "fundamentals",
	},
	{
		name: "Earnings Radar",
		title: "What a company just said in its results",
		text: "Its latest results release is fetched from the SEC and read on the spot by a decision model. Was guidance raised or cut, how strong does the quarter read, is demand weakening, which themes come up. Every answer carries its probability.",
		href: `${RADAR_URL}/`,
		cta: "Open Earnings",
		shot: "earnings",
	},
];
const promises = [
	["It describes. It does not advise.", "No buy or sell calls, no price targets, no predictions. The site says what the numbers and the filings show, and stops there."],
	["The numbers come from code.", "Prices, statements and ratios are computed the same way for every company. The AI comments on them and invents none."],
	["What you add is yours.", "My Hub keeps your name and email and the stocks you add. Never your password as you typed it, and you can delete all of it at any time."],
];
---

<Site title={SITE_NAME} description="The day's markets on one scale, the numbers of any US company and a reading of its latest results release, with a private page for your own stocks. Market Hub describes; it never tells you what to buy.">
	<section class="grid gap-x-14 gap-y-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-end">
		<div>
			<svg class="h-14 w-14 text-ink-strong sm:h-16 sm:w-16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" role="img" aria-label="Market Hub">
				<path d="M4 2v16M4 10h8"></path><circle cx="14.5" cy="10" r="2.75" fill="currentColor" stroke="none"></circle>
			</svg>
			<h1 class="lede mt-8 !text-ink-strong">What the market did today, what a company's numbers say, and what it just told its investors.</h1>
		</div>
		<div>
			<p class="max-w-md text-ink">
				Market Hub puts the day's markets, the fundamentals of any US-listed company and a reading of its latest results
				release on one site, with a private page for your own stocks. It describes. It never tells you what to buy or sell.
			</p>
			<div class="mt-6 flex flex-wrap gap-3">
				<a href={link("/today/")} class="btn btn-primary">See today's market</a>
				<a id="hero-hub" href={link("/signin/")} class="btn btn-ghost">Sign in to My Hub</a>
			</div>
		</div>
	</section>

	<section class="mt-14 sm:mt-20" aria-labelledby="film-title">
		<div class="sec-head">
			<h2 id="film-title" class="sec-title">Market Hub in a minute</h2>
			<span class="sec-note">With sound</span>
		</div>
		<video id="film" class="block aspect-video w-full border border-line bg-deep" controls muted loop playsinline preload="metadata" poster={link("/film-poster.jpg")}>
			<source src={link("/film.webm")} type="video/webm" />
			<source src={link("/film.mp4")} type="video/mp4" />
			<a href={link("/today/")} class="link">Your browser cannot play this film. Open today's market instead.</a>
		</video>
	</section>

	<div class="mt-20 space-y-20 sm:mt-28 sm:space-y-28">
		{parts.map((p, i) => (
			<section class="grid items-center gap-x-14 gap-y-8 lg:grid-cols-2">
				<div class:list={[i % 2 ? "lg:order-2" : ""]}>
					<p class="text-[13px] text-muted">{p.name}</p>
					<h2 class="mt-2 max-w-md text-[1.75rem] font-medium leading-tight tracking-tight text-ink-strong">{p.title}</h2>
					<p class="mt-4 max-w-md text-ink">{p.text}</p>
					<a href={p.href} class="link mt-5 inline-block">{p.cta} →</a>
				</div>
				<a href={p.href} class="block border border-line transition-colors hover:border-line-strong" tabindex="-1" aria-hidden="true">
					<img src={link(`/shots/${p.shot}.jpg`)} alt="" width="1280" height="800" loading="lazy" class="block h-auto w-full" />
				</a>
			</section>
		))}
	</div>

	<section class="sec mt-20 sm:mt-28" aria-labelledby="hub-title">
		<div class="grid gap-x-14 gap-y-6 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-end">
			<div>
				<p class="text-[13px] text-muted">My Hub</p>
				<h2 id="hub-title" class="mt-2 max-w-xl text-[1.75rem] font-medium leading-tight tracking-tight text-ink-strong">Your own stocks, on a private page</h2>
				<p id="hub-text" class="mt-4 max-w-xl text-ink">Keep a portfolio or a watchlist and see its value, today's move and your gain against what you paid. You sign in with Google or with an email and a password, and only you see it.</p>
			</div>
			<div><a id="hub-link" href={link("/signin/")} class="btn btn-primary">Sign in or create an account</a></div>
		</div>
	</section>

	<section class="sec mt-20 sm:mt-28" aria-labelledby="promises-title">
		<h2 id="promises-title" class="sec-title">What you can count on</h2>
		<dl class="mt-4 grid gap-x-14 gap-y-8 md:grid-cols-3">
			{promises.map(([t, d]) => (
				<div><dt class="text-lg font-medium leading-snug text-ink-strong">{t}</dt><dd class="mt-2 text-sm text-muted">{d}</dd></div>
			))}
		</dl>
	</section>
</Site>

<script>
	import { signedIn } from "../lib/api";
	import { link } from "../lib/site";

	// The film plays by itself while it is on screen, unless the visitor asked for less motion. It
	// starts muted, as browsers require; its sound is one click away in the player's controls.
	const film = document.getElementById("film") as HTMLVideoElement;
	if (!matchMedia("(prefers-reduced-motion: reduce)").matches)
		new IntersectionObserver(([e]) => (e.isIntersecting ? film.play().catch(() => {}) : film.pause()), { threshold: 0.5 }).observe(film);

	signedIn()
		.then((who) => {
			if (!who) return;
			const first = who.user.name.split(" ")[0];
			for (const id of ["hero-hub", "hub-link"]) {
				const a = document.getElementById(id) as HTMLAnchorElement;
				a.textContent = "Open My Hub";
				a.href = link("/dashboard/");
			}
			document.getElementById("hub-title")!.textContent = `Welcome back, ${first}`;
			document.getElementById("hub-text")!.textContent = "Your portfolio and watchlist are in your private hub.";
		})
		.catch(() => {});
</script>
