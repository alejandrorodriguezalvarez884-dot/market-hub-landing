---
// The landing page. It says one thing first: your portfolio, read by AI, with the film beside
// it. Then what that AI is for the reader (personal, effortless, cutting-edge), the rest of
// Market Hub in three lines, and what the site commits to. It sells in general terms and names
// no model and no provider, as the owner asked; what the site does in detail is on its pages. It asks the data provider
// for nothing, so a visit to it costs no market-data calls.
// The film is drawn and scored by code (film/, `make film`); it is no recording of the site.
import Site from "../components/Site.astro";
import { APP_STORE_URL, FUNDAMENTALS_URL, OPTIONS_URL, PEERS_URL, PLAYGROUND_URL, RADAR_URL, SITE_NAME, link } from "../lib/site";

// What the AI does for a portfolio, in three ideas.
const reading = [
	["Personal", "Built around you", "No generic market talk. The AI works on your own stocks and shows you what is really going on in your portfolio."],
	["Effortless", "Clarity in seconds", "Forget the spreadsheets and the endless charts. Open Market Hub and understand your portfolio at a glance, in plain words."],
	["State of the art", "Cutting-edge AI, working for you", "Powered by the latest generation of AI, the kind that is changing how people understand their money. And what is yours stays yours."],
];
// The rest of Market Hub, each part in a line and the ways into it.
const rest = [
	{
		title: "AI tools for any company",
		text: "Go deep on any US company in minutes, from its numbers to what it just told its investors.",
		links: [["Fundamentals Lab", `${FUNDAMENTALS_URL}/`], ["Earnings Radar", `${RADAR_URL}/`], ["Peer Map", `${PEERS_URL}/`], ["Playground", `${PLAYGROUND_URL}/`], ["Options Lab", `${OPTIONS_URL}/`]],
	},
	{
		title: "The market, every day",
		text: "Follow the day as it happens, with the news, opinion and video that matter. Open to everyone.",
		links: [["Today", link("/today/")], ["Markets", link("/markets/")], ["News", link("/news/")], ["Opinion", link("/opinion/")], ["Media", link("/media/")]],
	},
	{
		title: "In your pocket",
		text: "Take it all with you. Market Hub is on iPhone.",
		links: [["Download on the App Store", APP_STORE_URL]],
	},
];
const promises = [
	["It describes. It does not advise.", "No buy or sell calls, no price targets, no predictions. The AI says what the numbers and the filings show, and stops there."],
	["The numbers come from code.", "Prices, statements and ratios are computed the same way for every company. The AI comments on them and invents none."],
	["What you add is yours.", "My Hub keeps your name and email and the stocks you add. Never your password as you typed it, and you can delete all of it at any time."],
];
const phones = [
	{ shot: "analysis", alt: "The Analysis screen of the app: a portfolio taken apart by sector.", side: true },
	{ shot: "overview", alt: "The Overview screen of the app: a portfolio's value, its move today and a reading of it in plain sentences.", side: false },
	{ shot: "watchlist", alt: "The Watchlist screen of the app: the stocks followed, each with its chart and how it stands.", side: true },
];
---

<Site title={SITE_NAME} description="Your portfolio, read by AI: a clear, personal analysis of your own stocks in seconds, on the web and on iPhone. Market Hub describes; it never tells you what to buy.">
	<div class="home">
		<script is:inline>
			// The parts wait to come in only where a script is there to bring them in; if the page's own
			// script has not said so in a few seconds, they are all shown as they are.
			(() => {
				const page = document.currentScript.parentElement;
				page.classList.add("moves");
				setTimeout(() => page.dataset.ready || page.classList.remove("moves"), 4000);
			})();
		</script>

		<section class="hero">
			<div class="grid flex-1 items-center gap-x-14 gap-y-10 py-2 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
				<div>
					<svg class="h-12 w-12 text-ink-strong sm:h-14 sm:w-14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" role="img" aria-label="Market Hub" data-rv>
						<path d="M4 2v16M4 10h8"></path><circle cx="14.5" cy="10" r="2.75" fill="currentColor" stroke="none"></circle>
					</svg>
					<h1 class="headline mt-7" data-rv style="--i:1">Your portfolio, read by AI.</h1>
					<p class="mt-5 max-w-md text-[1.0625rem] text-ink" data-rv style="--i:2">
						Cutting-edge AI, working on your own stocks. Add what you hold or follow and get a clear, personal analysis of
						your portfolio in seconds, on the web and on your iPhone.
					</p>
					<div class="mt-7 flex flex-wrap items-center gap-3" data-rv style="--i:3">
						<a href={link("/signin/")} class="btn btn-primary" data-hub>Start with your portfolio</a>
						<a href={link("/today/")} class="btn btn-ghost">See today's market</a>
					</div>
					<p class="mt-5 text-[13px] text-muted" data-rv style="--i:4">
						Also an app for iPhone: <a href={APP_STORE_URL} class="link" rel="noopener">download it on the App Store</a>
					</p>
				</div>
				<figure data-rv style="--i:2">
					<video id="film" class="block aspect-video w-full border border-line bg-deep" controls muted loop playsinline preload="metadata" poster={link("/film-poster.jpg")}>
						<source src={link("/film.webm")} type="video/webm" />
						<source src={link("/film.mp4")} type="video/mp4" />
						<a href={link("/today/")} class="link">Your browser cannot play this film. Open today's market instead.</a>
					</video>
					<figcaption class="mt-2 flex items-baseline justify-between text-[12.5px] text-muted"><span>Market Hub in a minute</span><span>With sound</span></figcaption>
				</figure>
			</div>
			<a id="cue" href="#ai" class="cue">See what it does<span aria-hidden="true"></span></a>
		</section>

		<section id="ai" class="chapter" aria-labelledby="ai-title">
			<header class="chapter-head" data-rv>
				<div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-1">
					<h2 id="ai-title" class="chapter-title">Your own AI analysis. Personal, fast, cutting-edge.</h2>
					<p class="sec-note">On the web and on iPhone</p>
				</div>
			</header>
			<div class="mt-8 grid items-center gap-x-16 gap-y-14 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
				<div>
					<dl class="max-w-md divide-y divide-line border-y border-line">
						{reading.map(([tag, t, d], i) => (
							<div class="py-5" data-rv style={`--i:${i}`}>
								<dt><span class="block text-[12.5px] text-muted">{tag}</span><span class="mt-1 block text-[1.2rem] font-medium leading-snug tracking-tight text-ink-strong">{t}</span></dt>
								<dd class="mt-2 text-sm text-ink">{d}</dd>
							</div>
						))}
					</dl>
					<div class="mt-7 flex flex-wrap items-center gap-3" data-rv style="--i:3">
						<a href={link("/signin/")} class="btn btn-primary" data-hub>Sign in or create an account</a>
						<a href={APP_STORE_URL} class="store" rel="noopener" aria-label="Download Market Hub on the App Store">
							<svg viewBox="0 0 20 20" class="h-7 w-7 flex-none" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
								<rect x="5.5" y="1.75" width="9" height="16.5" rx="2.2"></rect><path d="M8.6 4h2.8"></path>
							</svg>
							<span><span class="block text-[11px] leading-none text-muted">Download on the</span><span class="mt-1 block text-[15px] font-medium leading-none">App Store</span></span>
						</a>
					</div>
				</div>
				<div id="phones" class="phones">
					{phones.map((p, i) => (
						<div data-rv style={`--i:${i + 1}`}>
							<div class:list={["phone", p.side ? "side" : ""]}>
								<img src={link(`/app/${p.shot}.jpg`)} alt={p.alt} width="660" height="1435" loading="lazy" decoding="async" />
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="chapter" aria-labelledby="rest-title">
			<header class="chapter-head" data-rv>
				<h2 id="rest-title" class="chapter-title">And there is more to Market Hub</h2>
			</header>
			<div class="mt-8 grid gap-x-14 gap-y-10 md:grid-cols-3">
				{rest.map((r, i) => (
					<div data-rv style={`--i:${i}`}>
						<h3 class="text-lg font-medium leading-snug text-ink-strong">{r.title}</h3>
						<p class="mt-2 text-sm text-ink">{r.text}</p>
						<p class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-[13px]">
							{r.links.map(([name, href]) => <a href={href} class="link" rel={href.startsWith("http") ? "noopener" : undefined}>{name}</a>)}
						</p>
					</div>
				))}
			</div>
		</section>

		<section class="chapter" aria-labelledby="promises-title">
			<header class="chapter-head" data-rv>
				<h2 id="promises-title" class="chapter-title">What you can count on</h2>
			</header>
			<dl class="mt-8 grid gap-x-14 gap-y-8 md:grid-cols-3">
				{promises.map(([t, d], i) => (
					<div data-rv style={`--i:${i}`}><dt class="text-lg font-medium leading-snug text-ink-strong">{t}</dt><dd class="mt-2 text-sm text-muted">{d}</dd></div>
				))}
			</dl>
		</section>

		<section class="chapter pb-6" aria-labelledby="start-title">
			<div class="chapter-head" data-rv></div>
			<div class="mt-10 grid items-end gap-x-14 gap-y-8 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
				<h2 id="start-title" class="lede !text-ink-strong" data-rv>Add your stocks. The AI does the rest.</h2>
				<div class="flex flex-wrap items-center gap-3" data-rv style="--i:1">
					<a href={link("/signin/")} class="btn btn-primary" data-hub>Start with your portfolio</a>
					<a href={link("/today/")} class="btn btn-ghost">See today's market</a>
					<a href={APP_STORE_URL} class="btn btn-ghost" rel="noopener">Download on the App Store</a>
				</div>
			</div>
		</section>
	</div>
</Site>

<style is:global>
	/* The page comes in a part at a time, as Today does. Every movement is a transform or an
	   opacity, and none of it happens for a reader who asked for less motion. */
	.home {
		--ease: cubic-bezier(0.2, 0.7, 0.1, 1);
		--head: 56px; /* the site's header, measured by the page */
	}
	.home.moves [data-rv] {
		opacity: 0;
		transform: translateY(14px);
		transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
		transition-delay: calc(var(--i, 0) * 70ms);
	}
	.home.moves [data-rv].in {
		opacity: 1;
		transform: none;
	}

	/* The top of the page fills the window: what Market Hub does for you, and the film beside it. */
	.home .hero {
		display: flex;
		flex-direction: column;
		min-height: calc(100svh - var(--head) - 5.5rem);
	}
	.headline {
		max-width: 11em;
		font-size: clamp(2.3rem, 1.2rem + 3.6vw, 3.9rem);
		font-weight: 500;
		line-height: 1.04;
		letter-spacing: -0.025em;
		color: var(--color-ink-strong);
		text-wrap: balance;
	}
	.cue {
		display: inline-flex;
		align-items: center;
		align-self: flex-end;
		gap: 10px;
		margin-top: 1.5rem;
		font-size: 12.5px;
		color: var(--color-muted);
		transition: opacity 0.4s, color 0.2s;
	}
	.cue:hover {
		color: var(--color-ink-strong);
	}
	.cue span {
		width: 1px;
		height: 22px;
		background: currentColor;
		transform-origin: 50% 0;
		animation: cue 1.9s var(--ease) infinite;
	}
	@keyframes cue {
		0% { transform: scaleY(0); opacity: 1; }
		55% { transform: scaleY(1); opacity: 1; }
		100% { transform: scaleY(1); opacity: 0; }
	}

	/* A part of the page: a rule that is drawn across, and its title. */
	.home .chapter {
		margin-top: 7rem;
		scroll-margin-top: calc(var(--head) + 1.25rem);
	}
	@media (min-width: 1024px) {
		.home .chapter {
			margin-top: 10rem;
		}
	}
	.home .chapter-head {
		position: relative;
		padding-top: 16px;
	}
	.home.moves .chapter-head[data-rv] {
		transform: none;
	}
	.home .chapter-head::before {
		content: "";
		position: absolute;
		inset: 0 0 auto 0;
		height: 1px;
		background: var(--color-line-strong);
		transform-origin: 0 50%;
		transition: transform 1.1s var(--ease);
	}
	.home.moves .chapter-head:not(.in)::before {
		transform: scaleX(0);
	}
	.home .chapter-title {
		max-width: 22em;
		font-size: clamp(1.45rem, 1rem + 1.5vw, 2.05rem);
		font-weight: 500;
		line-height: 1.15;
		letter-spacing: -0.015em;
		color: var(--color-ink-strong);
		text-wrap: balance;
	}

	/* The app's screens, in three phones. The two at the sides drift against the one in the middle
	   as the page goes by (--p is how far the block has gone through the window). */
	.phones {
		--p: 0.5;
		display: grid;
		grid-template-columns: 1fr 1.16fr 1fr;
		align-items: center;
		gap: clamp(10px, 2vw, 22px);
		max-width: 44rem;
		margin-inline: auto;
	}
	.phone {
		overflow: hidden;
		border: 1px solid var(--color-line-strong);
		border-radius: clamp(18px, 3.2vw, 34px);
		background: var(--color-deep);
		padding: clamp(4px, 0.7vw, 7px);
		transform: translateY(calc((var(--p) - 0.5) * 46px));
		will-change: transform;
	}
	.phone.side {
		transform: translateY(calc((0.5 - var(--p)) * 90px));
	}
	.phone img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: clamp(14px, 2.6vw, 28px);
	}

	/* Where the app is downloaded: a button drawn in the site's own ink. */
	.store {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		border: 1px solid var(--color-line-strong);
		border-radius: 3px;
		padding: 6px 16px 6px 10px;
		color: var(--color-ink-strong);
		transition: border-color 0.15s, background-color 0.15s;
	}
	.store:hover {
		border-color: var(--color-muted);
		background: var(--color-raised);
	}

	@media (prefers-reduced-motion: reduce) {
		.home.moves [data-rv],
		.home.moves .chapter-head:not(.in)::before,
		.phone,
		.phone.side {
			transform: none;
			transition: none;
		}
		.home.moves [data-rv] {
			opacity: 1;
		}
		.cue span {
			animation: none;
		}
	}
</style>

<script>
	import { signedIn } from "../lib/api";
	import { onScroll, reveal, still } from "../lib/motion";
	import { link } from "../lib/site";

	const $ = (id: string) => document.getElementById(id)!;
	const page = document.querySelector<HTMLElement>(".home")!;
	page.dataset.ready = "1";
	reveal(page.querySelector(".hero")!, 0);
	reveal(page);

	onScroll(() => {
		page.style.setProperty("--head", `${document.querySelector("header")!.getBoundingClientRect().height}px`);
		$("cue").style.opacity = scrollY > 60 ? "0" : "";
		// The phones: how far their block has gone through the window.
		const r = $("phones").getBoundingClientRect();
		$("phones").style.setProperty("--p", Math.min(1, Math.max(0, (innerHeight - r.top) / (innerHeight + r.height))).toFixed(3));
	});

	// The film plays by itself while it is on screen, unless the visitor asked for less motion. It
	// starts muted, as browsers require; its sound is one click away in the player's controls.
	const film = $("film") as HTMLVideoElement;
	if (!still()) new IntersectionObserver(([e]) => (e.isIntersecting ? film.play().catch(() => {}) : film.pause()), { threshold: 0.5 }).observe(film);

	// Someone who is signed in is sent to their hub, not to the sign-in page.
	signedIn()
		.then((who) => {
			if (!who) return;
			page.querySelectorAll<HTMLAnchorElement>("a[data-hub]").forEach((a) => {
				a.textContent = "Open My Hub";
				a.href = link("/dashboard/");
			});
		})
		.catch(() => {});
</script>
