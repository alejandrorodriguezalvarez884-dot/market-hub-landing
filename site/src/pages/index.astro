---
// The landing page. It says one thing first: your portfolio, powered by AI, with the film beside
// it. Right under it, the analysis tools, the site's strongest part, each a door of its own.
// Then what that AI is for the reader (personal, effortless, cutting-edge), the rest of
// Market Hub in two lines, and what the site commits to. It sells in general terms and names
// no model and no provider, as the owner asked; what the site does in detail is on its pages. It asks the data provider
// for nothing, so a visit to it costs no market-data calls.
// The film is drawn and scored by code (film/, `make film`); it is no recording of the site.
import Site from "../components/Site.astro";
import { APP_STORE_URL, FUNDAMENTALS_URL, OPTIONS_URL, PEERS_URL, PLAYGROUND_URL, RADAR_URL, SITE_NAME, link } from "../lib/site";
import { INSTAGRAM, X, YOUTUBE } from "../lib/media";

// What the AI does for a portfolio, in three ideas.
const reading = [
	["Personal", "Built around you", "No generic market talk. The AI works on your own stocks and shows you what is really going on in your portfolio."],
	["Effortless", "Clarity in seconds", "Forget the spreadsheets and the endless charts. Open Market Hub and understand your portfolio at a glance, in plain words."],
	["State of the art", "Cutting-edge AI, working for you", "Powered by the latest generation of AI, the kind that is changing how people understand their money. And what is yours stays yours."],
];
// The analysis tools, each in a line, with a mark drawn for it. A tool asks a visitor who is not
// signed in to sign in first, and brings them back to it.
const tools = [
	{ name: "Fundamentals Lab", about: "The numbers", text: "Statements, valuation, forward multiples and an AI reading of any US company.", url: FUNDAMENTALS_URL, icon: "M3 17V10m5 7V5m5 12v-5m5 5V3" },
	{ name: "Earnings Radar", about: "The results release", text: "What a company just told its investors: guidance, demand, margins and its themes.", url: RADAR_URL, icon: "M10 10l5.5-5.5M3 10a7 7 0 1 0 14 0a7 7 0 1 0-14 0M6.5 10a3.5 3.5 0 1 0 7 0a3.5 3.5 0 1 0-7 0" },
	{ name: "Peer Map", about: "Who does the same thing", text: "1,500 US companies, each next to the ones whose business reads the most alike.", url: PEERS_URL, icon: "M6 6l4 4l4-5M10 10l-4 5M10 10l5 5M3.4 5a1.6 1.6 0 1 0 3.2 0a1.6 1.6 0 1 0-3.2 0M13.4 4a1.6 1.6 0 1 0 3.2 0a1.6 1.6 0 1 0-3.2 0M3.4 16a1.6 1.6 0 1 0 3.2 0a1.6 1.6 0 1 0-3.2 0M14.4 16a1.6 1.6 0 1 0 3.2 0a1.6 1.6 0 1 0-3.2 0" },
	{ name: "Options Lab", about: "Options, read in detail", text: "Implied volatility, the Greeks, and strategies of up to eight legs with their payoff.", url: OPTIONS_URL, icon: "M2 15h5l6-10h5M2 5h5l2 3.4M11 11.6l2 3.4h5" },
	{ name: "Playground", about: "A board you ask for", text: "Ask in plain words for the charts and tables you want, side by side on one board.", url: PLAYGROUND_URL, icon: "M3 3h6v6H3zM11 3h6v6h-6zM3 11h6v6H3zM14 11v6M11 14h6" },
];
// What My Hub holds, said as its own pages say it, and its sections as its sidebar names them.
const inside = [
	["Overview", "What your portfolio is worth today, how it reads and how it stands against the indices."],
	["Analysis", "Your portfolio taken apart: what it is made of and how it moves."],
	["Watchlist", "The stocks you follow, side by side, with their charts and how each one stands."],
	["Five AI tools", "Fundamentals Lab, Earnings Radar, Peer Map, Options Lab and Playground, ready to open."],
];
const space = ["Overview", "Analysis", "Watchlist", "Community", "Portfolio"];
// The rest of Market Hub, each part in a line and the ways into it.
const rest = [
	{
		title: "The market, every day",
		text: "Follow the day as it happens, with the news, opinion and video that matter. Open to everyone.",
		links: [["Today", link("/today/")], ["Markets", link("/markets/")], ["News", link("/news/")], ["Opinion", link("/opinion/")], ["Media", link("/media/")]],
	},
	{
		title: "In your pocket",
		text: "Take it all with you. Market Hub is on iPhone.",
		links: [["Download on the App Store", APP_STORE_URL]],
	},
];
const promises = [
	["It describes. It does not advise.", "No buy or sell calls, no price targets, no predictions. The AI says what the numbers and the filings show, and stops there."],
	["The numbers come from code.", "Prices, statements and ratios are computed the same way for every company. The AI comments on them and invents none."],
	["What you add is yours.", "My Hub keeps your name and email and the stocks you add. Never your password as you typed it, and you can delete all of it at any time."],
];
// Who the site is, for search engines: the name it goes by (and the one it went by before), and
// its profiles elsewhere.
const FORMER_NAME = "Market Hub";
const home = new URL(link("/"), Astro.site ?? "https://themarkethub.app").href;
const schema = [
	{
		"@context": "https://schema.org",
		"@type": "WebSite",
		name: SITE_NAME,
		alternateName: [FORMER_NAME],
		url: home,
	},
	{
		"@context": "https://schema.org",
		"@type": "Organization",
		name: SITE_NAME,
		alternateName: FORMER_NAME,
		url: home,
		logo: new URL(link("/logo.png"), home).href,
		sameAs: [YOUTUBE.channel, `https://x.com/${X.handle}`, `https://www.instagram.com/${INSTAGRAM.handle}/`, APP_STORE_URL],
	},
];
const phones = [
	{ shot: "analysis", alt: "The Analysis screen of the app: a portfolio taken apart by sector.", side: true },
	{ shot: "overview", alt: "The Overview screen of the app: a portfolio's value, its move today and a reading of it in plain sentences.", side: false },
	{ shot: "watchlist", alt: "The Watchlist screen of the app: the stocks followed, each with its chart and how it stands.", side: true },
];
---

<Site title={`${SITE_NAME} — Your portfolio, powered by AI`} schema={schema} description="AI portfolio analysis: a clear, personal reading of your own stocks in seconds, on the web and on iPhone. The Market Hub describes; it never tells you what to buy.">
	<div class="home">
		<script is:inline>
			// The parts wait to come in only where a script is there to bring them in; if the page's own
			// script has not said so in a few seconds, they are all shown as they are.
			(() => {
				const page = document.currentScript.parentElement;
				page.classList.add("moves");
				setTimeout(() => page.dataset.ready || page.classList.remove("moves"), 4000);
			})();
		</script>

		<section class="hero">
			<div class="grid flex-1 items-center gap-x-14 gap-y-10 py-2 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
				<div>
					<svg class="h-12 w-12 text-ink-strong sm:h-14 sm:w-14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" role="img" aria-label={SITE_NAME} data-rv>
						<path d="M4 2v16M4 10h8"></path><circle cx="14.5" cy="10" r="2.75" fill="currentColor" stroke="none"></circle>
					</svg>
					<h1 class="headline mt-7" data-rv style="--i:1">Your portfolio, powered by AI.</h1>
					<p class="mt-5 max-w-md text-[1.0625rem] text-ink" data-rv style="--i:2">
						AI portfolio analysis, on your own stocks. Add what you hold or follow and get a clear, personal reading of
						your portfolio in seconds, on the web and on your iPhone.
					</p>
					<div class="mt-7 flex flex-wrap items-center gap-3" data-rv style="--i:3">
						<a href={link("/signin/")} class="btn btn-primary btn-big" data-hub>Open My Hub, it's free<span aria-hidden="true">→</span></a>
						<a href="#tools" class="btn btn-tools btn-big">Explore the 5 AI tools<span aria-hidden="true">↓</span></a>
					</div>
					<p class="mt-5 text-[13px] text-muted" data-rv style="--i:4">
						Sign in with Google or your email. Also on iPhone: <a href={APP_STORE_URL} class="link" rel="noopener">download it on the App Store</a>
					</p>
				</div>
				<figure data-rv style="--i:2">
					<video id="film" class="block aspect-video w-full border border-line bg-deep" controls muted loop playsinline preload="metadata" poster={link("/film-poster.jpg")}>
						<source src={link("/film.webm")} type="video/webm" />
						<source src={link("/film.mp4")} type="video/mp4" />
						<a href={link("/today/")} class="link">Your browser cannot play this film. Open today's market instead.</a>
					</video>
					<figcaption class="mt-2 flex items-baseline justify-between text-[12.5px] text-muted"><span>Market Hub in a minute</span><span>With sound</span></figcaption>
				</figure>
			</div>
			<a id="cue" href="#tools" class="cue">See the tools<span aria-hidden="true"></span></a>
		</section>

		<section id="tools" class="chapter" aria-labelledby="tools-title">
			<header class="chapter-head" data-rv>
				<div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-1">
					<h2 id="tools-title" class="chapter-title">Five AI tools to go deep on any US company.</h2>
					<p class="sec-note">One sign-in opens them all</p>
				</div>
				<p class="mt-3 max-w-2xl text-ink">
					From a company's numbers to what it just told its investors, who it really competes with and how its options are priced. Pick one and start.
				</p>
			</header>
			<ul class="tool-grid mt-8">
				{tools.map((t, i) => (
					<li data-rv style={`--i:${i}`}>
						<a href={`${t.url}/`} class="tool">
							<svg viewBox="0 0 20 20" class="h-6 w-6 flex-none text-ink-strong" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={t.icon}></path></svg>
							<span class="mt-5 block text-[12.5px] text-muted">{t.about}</span>
							<span class="mt-1 block text-[1.2rem] font-medium leading-snug tracking-tight text-ink-strong">{t.name}</span>
							<span class="mt-2 block flex-1 text-sm text-ink">{t.text}</span>
							<span class="tool-go mt-5">Open {t.name}<span aria-hidden="true">→</span></span>
						</a>
					</li>
				))}
			</ul>
			<p class="mt-6 text-[13px] text-muted" data-rv style="--i:5">
				They live in My Hub, behind one free sign-in. <a href={link("/tools/")} class="link">What each tool does</a>
			</p>
		</section>

		<section id="hub" class="chapter" aria-labelledby="hub-title">
			<div class="hub-band" data-rv>
				<div class="grid items-center gap-x-14 gap-y-10 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)]">
					<div>
						<p class="label">My Hub</p>
						<h2 id="hub-title" class="hub-title mt-3">Your private space, with everything inside.</h2>
						<p class="mt-4 max-w-xl text-ink">
							Add the stocks you hold or follow, and My Hub turns them into your own dashboard, with the five AI tools one click away. Free, and only you see it.
						</p>
						<ul class="mt-7 grid gap-x-8 gap-y-5 sm:grid-cols-2">
							{inside.map(([t, d]) => (
								<li class="hub-point"><span class="block font-medium text-ink-strong">{t}</span><span class="mt-1 block text-sm text-ink">{d}</span></li>
							))}
						</ul>
						<div class="mt-9 flex flex-wrap items-center gap-x-5 gap-y-3">
							<a href={link("/signin/")} class="btn btn-primary btn-big" data-hub>Open My Hub, it's free<span aria-hidden="true">→</span></a>
							<span class="text-[13px] text-muted">Google or email. Delete it all whenever you like.</span>
						</div>
					</div>
					<div class="hub-window" aria-hidden="true">
						<div class="hub-bar"><i></i><i></i><i></i><span>themarkethub.app/dashboard</span></div>
						<div class="hub-side">
							<div class="flex items-center gap-2 text-[13px] font-semibold text-ink-strong">
								<svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 2v16M4 10h8"></path><circle cx="14.5" cy="10" r="2.75" fill="currentColor" stroke="none"></circle></svg>
								The Market Hub <span class="hub-tag">My Hub</span>
							</div>
							<p class="hub-private"><span></span>Private area. Only you see it.</p>
							<p class="hub-group">Your space</p>
							{space.map((s, i) => <p class:list={["hub-item", i === 0 && "on"]}>{s}</p>)}
							<p class="hub-group">Tools</p>
							{tools.map((t) => <p class="hub-item tool-item">{t.name}<span>AI</span></p>)}
						</div>
					</div>
				</div>
			</div>
		</section>

		<section id="ai" class="chapter" aria-labelledby="ai-title">
			<header class="chapter-head" data-rv>
				<div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-1">
					<h2 id="ai-title" class="chapter-title">Your own AI analysis. Personal, fast, cutting-edge.</h2>
					<p class="sec-note">On the web and on iPhone</p>
				</div>
			</header>
			<div class="mt-8 grid items-center gap-x-16 gap-y-14 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
				<div>
					<dl class="max-w-md divide-y divide-line border-y border-line">
						{reading.map(([tag, t, d], i) => (
							<div class="py-5" data-rv style={`--i:${i}`}>
								<dt><span class="block text-[12.5px] text-muted">{tag}</span><span class="mt-1 block text-[1.2rem] font-medium leading-snug tracking-tight text-ink-strong">{t}</span></dt>
								<dd class="mt-2 text-sm text-ink">{d}</dd>
							</div>
						))}
					</dl>
					<div class="mt-7 flex flex-wrap items-center gap-3" data-rv style="--i:3">
						<a href={link("/signin/")} class="btn btn-primary" data-hub>Open My Hub, it's free</a>
						<a href={APP_STORE_URL} class="store" rel="noopener" aria-label="Download Market Hub on the App Store">
							<svg viewBox="0 0 20 20" class="h-7 w-7 flex-none" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
								<rect x="5.5" y="1.75" width="9" height="16.5" rx="2.2"></rect><path d="M8.6 4h2.8"></path>
							</svg>
							<span><span class="block text-[11px] leading-none text-muted">Download on the</span><span class="mt-1 block text-[15px] font-medium leading-none">App Store</span></span>
						</a>
					</div>
				</div>
				<div id="phones" class="phones">
					{phones.map((p, i) => (
						<div data-rv style={`--i:${i + 1}`}>
							<div class:list={["phone", p.side ? "side" : ""]}>
								<img src={link(`/app/${p.shot}.jpg`)} alt={p.alt} width="660" height="1435" loading="lazy" decoding="async" />
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="chapter" aria-labelledby="rest-title">
			<header class="chapter-head" data-rv>
				<h2 id="rest-title" class="chapter-title">And there is more to Market Hub</h2>
			</header>
			<div class="mt-8 grid gap-x-14 gap-y-10 md:grid-cols-2">
				{rest.map((r, i) => (
					<div data-rv style={`--i:${i}`}>
						<h3 class="text-lg font-medium leading-snug text-ink-strong">{r.title}</h3>
						<p class="mt-2 text-sm text-ink">{r.text}</p>
						<p class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-[13px]">
							{r.links.map(([name, href]) => <a href={href} class="link" rel={href.startsWith("http") ? "noopener" : undefined}>{name}</a>)}
						</p>
					</div>
				))}
			</div>
		</section>

		{/* The newest opinion articles: the service puts them here as it hands the page out (previews.py). */}
		<div id="home-opinion"></div>

		<section class="chapter" aria-labelledby="promises-title">
			<header class="chapter-head" data-rv>
				<h2 id="promises-title" class="chapter-title">What you can count on</h2>
			</header>
			<dl class="mt-8 grid gap-x-14 gap-y-8 md:grid-cols-3">
				{promises.map(([t, d], i) => (
					<div data-rv style={`--i:${i}`}><dt class="text-lg font-medium leading-snug text-ink-strong">{t}</dt><dd class="mt-2 text-sm text-muted">{d}</dd></div>
				))}
			</dl>
		</section>

		<section id="start" class="chapter pb-6" aria-labelledby="start-title">
			<div class="chapter-head" data-rv></div>
			<div class="mt-10 grid items-end gap-x-14 gap-y-8 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
				<h2 id="start-title" class="lede !text-ink-strong" data-rv>Add your stocks. The AI does the rest.</h2>
				<div class="flex flex-wrap items-center gap-3" data-rv style="--i:1">
					<a href={link("/signin/")} class="btn btn-primary" data-hub>Open My Hub, it's free</a>
					<a href="#tools" class="btn btn-tools">Explore the AI tools</a>
					<a href={APP_STORE_URL} class="btn btn-ghost" rel="noopener">Download on the App Store</a>
				</div>
			</div>
		</section>

		{/* For visitors only, once the top of the page is behind them: the way into My Hub stays at
		   hand, and steps aside where the page itself already offers it. */}
		<div id="dock" class="dock up" hidden>
			<p><span class="font-medium text-ink-strong">My Hub</span><span class="hidden sm:inline"> · your portfolio and five AI tools</span><span class="text-muted"> · free</span></p>
			<a href={link("/signin/")} class="btn btn-primary">Open My Hub<span aria-hidden="true">→</span></a>
		</div>
	</div>
</Site>

<style is:global>
	/* The page comes in a part at a time, as Today does. Every movement is a transform or an
	   opacity, and none of it happens for a reader who asked for less motion. */
	.home {
		--ease: cubic-bezier(0.2, 0.7, 0.1, 1);
		--head: 56px; /* the site's header, measured by the page */
	}
	.home.moves [data-rv] {
		opacity: 0;
		transform: translateY(14px);
		transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
		transition-delay: calc(var(--i, 0) * 70ms);
	}
	.home.moves [data-rv].in {
		opacity: 1;
		transform: none;
	}

	/* The top of the page fills the window: what Market Hub does for you, and the film beside it. */
	.home .hero {
		display: flex;
		flex-direction: column;
		min-height: calc(100svh - var(--head) - 5.5rem);
	}
	.headline {
		max-width: 11em;
		font-size: clamp(2.3rem, 1.2rem + 3.6vw, 3.9rem);
		font-weight: 500;
		line-height: 1.04;
		letter-spacing: -0.025em;
		color: var(--color-ink-strong);
		text-wrap: balance;
	}
	.cue {
		display: inline-flex;
		align-items: center;
		align-self: flex-end;
		gap: 10px;
		margin-top: 1.5rem;
		font-size: 12.5px;
		color: var(--color-muted);
		transition: opacity 0.4s, color 0.2s;
	}
	.cue:hover {
		color: var(--color-ink-strong);
	}
	.cue span {
		width: 1px;
		height: 22px;
		background: currentColor;
		transform-origin: 50% 0;
		animation: cue 1.9s var(--ease) infinite;
	}
	@keyframes cue {
		0% { transform: scaleY(0); opacity: 1; }
		55% { transform: scaleY(1); opacity: 1; }
		100% { transform: scaleY(1); opacity: 0; }
	}

	/* A part of the page: a rule that is drawn across, and its title. */
	.home .chapter {
		margin-top: 7rem;
		scroll-margin-top: calc(var(--head) + 1.25rem);
	}
	@media (min-width: 1024px) {
		.home .chapter {
			margin-top: 10rem;
		}
	}
	.home .chapter-head {
		position: relative;
		padding-top: 16px;
	}
	.home.moves .chapter-head[data-rv] {
		transform: none;
	}
	.home .chapter-head::before {
		content: "";
		position: absolute;
		inset: 0 0 auto 0;
		height: 1px;
		background: var(--color-line-strong);
		transform-origin: 0 50%;
		transition: transform 1.1s var(--ease);
	}
	.home.moves .chapter-head:not(.in)::before {
		transform: scaleX(0);
	}
	.home .chapter-title {
		max-width: 22em;
		font-size: clamp(1.45rem, 1rem + 1.5vw, 2.05rem);
		font-weight: 500;
		line-height: 1.15;
		letter-spacing: -0.015em;
		color: var(--color-ink-strong);
		text-wrap: balance;
	}

	/* The second way in, beside the first: the tools, outlined in full ink so it reads as a
	   button of its own and not as a lesser one. */
	.btn-tools {
		border: 1px solid var(--color-ink-strong);
		color: var(--color-ink-strong);
		transition: background-color 0.15s, color 0.15s;
	}
	.btn-tools:hover {
		background: var(--color-ink-strong);
		color: var(--color-page);
	}

	/* The ways into My Hub, a size up from the site's buttons. */
	.btn-big {
		padding: 11px 20px;
		font-size: 15px;
		font-weight: 500;
	}

	/* My Hub: a band of its own, lit from one corner, with a drawing of its sidebar. */
	.hub-band {
		position: relative;
		overflow: hidden;
		border: 1px solid var(--color-line-strong);
		border-radius: 6px;
		background:
			radial-gradient(120% 90% at 100% 0%, rgb(53 201 143 / 0.09), transparent 55%),
			var(--color-panel);
		padding: clamp(24px, 5vw, 56px);
	}
	.hub-title {
		max-width: 16em;
		font-size: clamp(1.7rem, 1.1rem + 2vw, 2.6rem);
		font-weight: 500;
		line-height: 1.08;
		letter-spacing: -0.02em;
		color: var(--color-ink-strong);
		text-wrap: balance;
	}
	.hub-point {
		border-left: 2px solid var(--color-up);
		padding-left: 14px;
	}
	.hub-window {
		overflow: hidden;
		border: 1px solid var(--color-line-strong);
		border-radius: 8px;
		background: var(--color-deep);
		box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.8);
		max-width: 22rem;
		width: 100%;
		justify-self: center;
	}
	.hub-bar {
		display: flex;
		align-items: center;
		gap: 6px;
		border-bottom: 1px solid var(--color-line);
		padding: 9px 12px;
		font-size: 11px;
		color: var(--color-faint);
	}
	.hub-bar i {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--color-line-strong);
	}
	.hub-bar span {
		margin-left: 8px;
	}
	.hub-side {
		padding: 16px 14px 18px;
	}
	.hub-tag {
		border: 1px solid var(--color-line-strong);
		border-radius: 3px;
		padding: 1px 5px;
		font-size: 10px;
		font-weight: 500;
		color: var(--color-muted);
	}
	.hub-private {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-top: 14px;
		border: 1px solid var(--color-line);
		border-radius: 5px;
		background: var(--color-panel);
		padding: 7px 10px;
		font-size: 11px;
		color: var(--color-muted);
	}
	.hub-private span {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--color-up);
	}
	.hub-group {
		margin: 16px 8px 4px;
		font-size: 10.5px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-faint);
	}
	.hub-item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-radius: 4px;
		padding: 6px 8px;
		font-size: 13px;
		font-weight: 600;
		color: var(--color-ink);
	}
	.hub-item.on {
		background: var(--color-raised);
		color: var(--color-ink-strong);
	}
	.tool-item span {
		border-radius: 3px;
		background: var(--color-up-soft);
		padding: 1px 5px;
		font-size: 10px;
		color: var(--color-up);
	}

	/* The dock at the foot of the window, for visitors. */
	.dock {
		position: fixed;
		left: 50%;
		bottom: max(16px, env(safe-area-inset-bottom));
		z-index: 40;
		display: flex;
		align-items: center;
		gap: 16px;
		width: max-content;
		max-width: calc(100vw - 32px);
		border: 1px solid var(--color-line-strong);
		border-radius: 8px;
		background: rgb(16 18 19 / 0.92);
		backdrop-filter: blur(10px);
		box-shadow: 0 18px 50px -12px rgb(0 0 0 / 0.85);
		padding: 8px 8px 8px 16px;
		font-size: 13.5px;
		color: var(--color-ink);
		transform: translate(-50%, 0);
		transition: transform 0.45s var(--ease), opacity 0.3s;
	}
	.dock.up {
		opacity: 0;
		pointer-events: none;
		transform: translate(-50%, 140%);
	}

	/* The tools: five doors, each a card that is a link as a whole. */
	.tool-grid {
		display: grid;
		gap: 12px;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 13.5rem), 1fr));
	}
	.tool-grid > li {
		display: flex;
	}
	.tool {
		display: flex;
		flex-direction: column;
		width: 100%;
		border: 1px solid var(--color-line-strong);
		border-radius: 4px;
		background: var(--color-panel);
		padding: 20px 20px 18px;
		transition: border-color 0.2s, background-color 0.2s, transform 0.3s var(--ease);
	}
	.tool:hover,
	.tool:focus-visible {
		border-color: var(--color-ink-strong);
		background: var(--color-raised);
		transform: translateY(-3px);
	}
	.tool-go {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 13px;
		font-weight: 500;
		color: var(--color-ink-strong);
	}
	.tool-go span {
		transition: transform 0.2s var(--ease);
	}
	.tool:hover .tool-go span {
		transform: translateX(4px);
	}

	/* The app's screens, in three phones. The two at the sides drift against the one in the middle
	   as the page goes by (--p is how far the block has gone through the window). */
	.phones {
		--p: 0.5;
		display: grid;
		grid-template-columns: 1fr 1.16fr 1fr;
		align-items: center;
		gap: clamp(10px, 2vw, 22px);
		max-width: 44rem;
		margin-inline: auto;
	}
	.phone {
		overflow: hidden;
		border: 1px solid var(--color-line-strong);
		border-radius: clamp(18px, 3.2vw, 34px);
		background: var(--color-deep);
		padding: clamp(4px, 0.7vw, 7px);
		transform: translateY(calc((var(--p) - 0.5) * 46px));
		will-change: transform;
	}
	.phone.side {
		transform: translateY(calc((0.5 - var(--p)) * 90px));
	}
	.phone img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: clamp(14px, 2.6vw, 28px);
	}

	/* Where the app is downloaded: a button drawn in the site's own ink. */
	.store {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		border: 1px solid var(--color-line-strong);
		border-radius: 3px;
		padding: 6px 16px 6px 10px;
		color: var(--color-ink-strong);
		transition: border-color 0.15s, background-color 0.15s;
	}
	.store:hover {
		border-color: var(--color-muted);
		background: var(--color-raised);
	}

	@media (prefers-reduced-motion: reduce) {
		.home.moves [data-rv],
		.home.moves .chapter-head:not(.in)::before,
		.phone,
		.phone.side,
		.tool,
		.tool:hover,
		.tool:hover .tool-go span {
			transform: none;
			transition: none;
		}
		.home.moves [data-rv] {
			opacity: 1;
		}
		.cue span {
			animation: none;
		}
	}
</style>

<script>
	import { signedIn } from "../lib/api";
	import { onScroll, reveal, still } from "../lib/motion";
	import { link } from "../lib/site";

	const $ = (id: string) => document.getElementById(id)!;
	const page = document.querySelector<HTMLElement>(".home")!;
	page.dataset.ready = "1";
	reveal(page.querySelector(".hero")!, 0);
	reveal(page);

	onScroll(() => {
		page.style.setProperty("--head", `${document.querySelector("header")!.getBoundingClientRect().height}px`);
		$("cue").style.opacity = scrollY > 60 ? "0" : "";
		// The phones: how far their block has gone through the window.
		const r = $("phones").getBoundingClientRect();
		$("phones").style.setProperty("--p", Math.min(1, Math.max(0, (innerHeight - r.top) / (innerHeight + r.height))).toFixed(3));
	});

	// The film plays by itself while it is on screen, unless the visitor asked for less motion. It
	// starts muted, as browsers require; its sound is one click away in the player's controls.
	const film = $("film") as HTMLVideoElement;
	if (!still()) new IntersectionObserver(([e]) => (e.isIntersecting ? film.play().catch(() => {}) : film.pause()), { threshold: 0.5 }).observe(film);

	// Someone who is signed in is sent to their hub, not to the sign-in page.
	// A visitor gets the dock instead.
	signedIn()
		.catch(() => null)
		.then((who) => {
			if (!who) return dock();
			page.querySelectorAll<HTMLAnchorElement>("a[data-hub]").forEach((a) => {
				a.textContent = "Open My Hub";
				a.href = link("/dashboard/");
			});
		});

	// The dock: shown once the top of the page has gone by, hidden again while the My Hub band or
	// the closing call is on screen.
	function dock() {
		const bar = $("dock");
		bar.hidden = false;
		const seen = new Set<Element>();
		const io = new IntersectionObserver((entries) => {
			entries.forEach((e) => (e.isIntersecting ? seen.add(e.target) : seen.delete(e.target)));
			bar.classList.toggle("up", seen.size > 0);
		});
		[page.querySelector(".hero")!, $("hub"), $("start")].forEach((el) => io.observe(el));
	}
</script>
