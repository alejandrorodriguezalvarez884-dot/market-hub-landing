---
// Sign-in with Google, into the private area. A signed-in visitor goes straight to it.
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
import { SITE_NAME, link } from "../lib/site";

const points = [
	["Your portfolio, valued every day", "Positions with your average cost: value, today's move, gain or loss, weights and sectors."],
	["Or just the stocks you follow", "A watchlist with day moves, returns and the 52-week range."],
	["The analysis tools, included", "Fundamentals Lab and the Earnings Radar open with this same sign-in."],
	["Private by design", "Only you see your hub. We keep your Google name, email and picture, and the stocks you add. Delete it all at any time."],
];
---

<Layout title={`Sign in — ${SITE_NAME}`} description="Sign in with Google to your private Market Hub: your portfolio and watchlist on one dashboard.">
	<div class="grid min-h-screen lg:grid-cols-2">
		<section class="hidden flex-col justify-between border-r border-line bg-deep p-10 lg:flex">
			<Logo />
			<div class="max-w-md">
				<p class="label text-[#5b8cff]">My Hub</p>
				<h1 class="mt-2 text-3xl font-bold leading-tight text-ink-strong">Your private space for the stocks you own and follow</h1>
				<ul class="mt-8 space-y-5">
					{points.map(([t, d]) => (
						<li class="flex gap-3">
							<svg class="mt-0.5 h-5 w-5 flex-none text-up" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12l5 5L20 7"></path></svg>
							<div><p class="font-semibold text-ink-strong">{t}</p><p class="mt-0.5 text-[13px] leading-relaxed text-muted">{d}</p></div>
						</li>
					))}
				</ul>
			</div>
			<a href={link("/")} class="text-xs text-muted hover:text-ink">← Back to the markets</a>
		</section>

		<section class="flex flex-col items-center justify-center px-4 py-12">
			<div class="mb-10 lg:hidden"><Logo /></div>
			<div class="panel w-full max-w-sm p-6 sm:p-8">
				<div class="mb-1 flex items-center gap-2 text-[11px] text-muted">
					<svg class="h-3.5 w-3.5 text-up" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
					Private area
				</div>
				<h2 class="text-xl font-bold text-ink-strong">Sign in to My Hub</h2>
				<p class="mt-1 text-[13px] text-muted">With your Google account. No password to remember.</p>
				<div id="signin" class="mt-6 flex min-h-[44px] justify-center"></div>
				<p id="signin-note" class="mt-3 text-center text-[13px] text-muted" hidden></p>
				<p class="mt-6 border-t border-line pt-4 text-[11px] leading-relaxed text-muted">
					We keep your Google name, email and picture, and the stocks you add. Nothing else, and no tracking cookies.{" "}
					<a href={link("/privacy/")} class="underline hover:text-ink">Privacy</a>
				</p>
			</div>
			<a href={link("/")} class="mt-6 text-xs text-muted hover:text-ink lg:hidden">← Back to the markets</a>
		</section>
	</div>
</Layout>

<script>
	import { api, config, signedIn } from "../lib/api";
	import { link } from "../lib/site";

	const box = document.getElementById("signin")!;
	const note = document.getElementById("signin-note")!;
	const say = (text: string) => ((note.textContent = text), (note.hidden = !text));
	// Where to go after signing in: a path of this site, or an analysis tool on a subdomain of
	// the hub's domain (https only). Anything else falls back to the hub, so a crafted ?next=
	// cannot send the visitor elsewhere.
	function nextFrom(domain: string | null): string {
		const n = new URLSearchParams(location.search).get("next") ?? "";
		if (n.startsWith("/") && !n.startsWith("//")) return n;
		if (domain) {
			try {
				const u = new URL(n);
				if (u.protocol === "https:" && u.hostname.endsWith(`.${domain}`) && !u.username && !u.password) return u.href;
			} catch {
				/* not a URL */
			}
		}
		return link("/dashboard/");
	}
	let next = nextFrom(null);

	function loadGoogle(): Promise<void> {
		return new Promise((resolve, reject) => {
			const s = document.createElement("script");
			s.src = "https://accounts.google.com/gsi/client";
			s.async = true;
			s.onload = () => resolve();
			s.onerror = () => reject(new Error("Google sign-in could not load."));
			document.head.append(s);
		});
	}

	async function start() {
		try {
			const cfg = await config();
			next = nextFrom(cfg.domain);
			const tool = !next.startsWith("/");
			const who = await signedIn();
			if (who) return location.replace(who.has_data || tool ? next : link("/portfolio/?welcome=1"));
			if (!cfg.google_client_id) return say("Sign-in is not configured yet.");
			await loadGoogle();
			const g = (window as any).google.accounts.id;
			g.initialize({
				client_id: cfg.google_client_id,
				ux_mode: "popup",
				callback: async (resp: { credential: string }) => {
					say("Signing in…");
					try {
						const r = await api<{ has_data: boolean }>("/api/auth/google", { method: "POST", body: JSON.stringify({ credential: resp.credential }) });
						location.replace(r.has_data || tool ? next : link("/portfolio/?welcome=1"));
					} catch (e) {
						say(e instanceof Error ? e.message : "Sign-in failed.");
					}
				},
			});
			g.renderButton(box, { theme: "filled_black", size: "large", shape: "rectangular", text: "continue_with", width: 300 });
		} catch (e) {
			say(e instanceof Error ? e.message : "Sign-in is not available right now.");
		}
	}
	start();
</script>
