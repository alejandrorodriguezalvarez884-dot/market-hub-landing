---
// One opinion article, with its sources and, under it, the readers' comments as threads: anyone
// reads them, a signed-in reader writes and answers.
import Site from "../../components/Site.astro";
import { link } from "../../lib/site";
---

<Site title="Opinion" description="An opinion article of Market Hub, with its readers' comments.">
	<div class="mx-auto max-w-[44rem]">
		<a href={link("/opinion/")} class="text-[13px] text-muted hover:text-ink-strong"><span aria-hidden="true">←</span> Opinion</a>
		<article id="piece" class="mt-8"><div class="skeleton h-5 w-56"></div><div class="skeleton mt-4 h-24"></div><div class="skeleton mt-8 h-96"></div></article>
		<section id="comments" class="sec mt-16" aria-labelledby="comments-title" hidden>
			<div class="sec-head"><h2 id="comments-title" class="sec-title">Comments</h2><span id="comments-count" class="sec-note"></span></div>
			<div id="composer"></div>
			<div id="thread" class="mt-6"></div>
		</section>
	</div>
</Site>

<script>
	import { ApiError } from "../../lib/api";
	import { add, h, linkTo } from "../../lib/dom";
	import { article, comment, cover, overline, prose, removeComment, thread, type Article } from "../../lib/opinion";
	import { link } from "../../lib/site";
	import { mountThread } from "../../lib/thread";
	import { quoteHref } from "../../lib/widgets";

	const $ = (id: string) => document.getElementById(id)!;
	const slug = new URLSearchParams(location.search).get("slug") ?? "";

	function draw(a: Article) {
		document.title = `${a.title} — Market Hub`;
		const sources = a.sources.length
			? add(h("footer", "sec mt-12"),
				add(h("div", "sec-head"), h("h2", "sec-title", "Sources")),
				add(h("ul", "space-y-1.5 text-sm text-ink"), ...a.sources.map((s) => {
					const own = s.url.startsWith("/");
					const to = linkTo(own ? link(s.url) : s.url, "link", s.title);
					if (!own) (to.target = "_blank"), (to.rel = "noopener");
					return add(h("li"), to, own ? "" : " ↗");
				})))
			: null;
		$("piece").replaceChildren();
		add($("piece"),
			overline(a),
			h("h1", "mt-3 text-[2rem] font-medium leading-[1.12] tracking-tight text-ink-strong sm:text-[2.6rem]", a.title),
			h("p", "mt-5 text-xl leading-relaxed text-ink-strong", a.dek),
			cover(a, "mt-8 aspect-video w-full"),
			add(h("div", "mt-8 space-y-5 text-[17px] leading-[1.7] text-ink"), ...prose(a.body)),
			a.tickers.length ? add(h("p", "mt-8 flex flex-wrap gap-1.5"), ...a.tickers.map((t) => linkTo(quoteHref(t), "chip", t))) : null,
			sources);
	}

	// --- Comments ----------------------------------------------------------------------------------

	const load = mountThread({ composer: $("composer"), list: $("thread"), count: $("comments-count") }, {
		load: () => thread(slug),
		post: (text, parent) => comment(slug, text, parent),
		remove: removeComment,
		note: "Shown with your first name. Be civil.",
		visitor: () => add(h("p", "text-sm text-ink"), linkTo(link(`/signin/?next=${encodeURIComponent(`${location.pathname}${location.search}#comments`)}`), "btn btn-ghost", "Sign in to comment"),
			h("span", "ml-3 text-muted", "Reading needs no account.")),
	});

	article(slug)
		.then((a) => {
			draw(a);
			$("comments").hidden = false;
			return load();
		})
		.catch((e) => {
			$("piece").replaceChildren(
				h("p", "text-ink", e instanceof ApiError && e.status === 404 ? "This article is not here." : "This article is not available right now."),
				add(h("p", "mt-4"), linkTo(link("/opinion/"), "link", "All the articles")));
		});
</script>
