---
// The analysis tools of the brand, each a site of its own.
import Site from "../components/Site.astro";
---

<Site title="Tools" description="The analysis tools of Market Hub: Fundamentals Lab and the Earnings Radar.">
	<div class="mb-10 max-w-2xl">
		<h1 class="text-[2rem] font-medium leading-tight tracking-tight text-ink-strong">Read a company in depth</h1>
		<p class="mt-3 text-ink">Two tools, each for any US-listed company. They open with your Market Hub sign-in, and every stock page links straight to them.</p>
	</div>
	<div id="tools" class="grid gap-x-14 gap-y-10 md:grid-cols-2"><div class="skeleton h-56"></div><div class="skeleton h-56"></div></div>
</Site>

<script>
	import { config } from "../lib/api";
	import { add, h } from "../lib/dom";

	const TOOLS = [
		{
			key: "fundamentals_lab" as const,
			name: "Fundamentals Lab",
			about: "The numbers",
			points: [
				"Statements, margins and returns on capital, year by year",
				"Valuation against the company's own history",
				"Forward multiples from the analysts' consensus",
				"Technical picture and side-by-side comparison of up to five companies",
				"An AI reading that comments the numbers and invents none",
			],
		},
		{
			key: "earnings_radar" as const,
			name: "Earnings Radar",
			about: "The results release",
			points: [
				"Reads a company's latest results release when you ask",
				"Is guidance raised or cut, is demand weakening, are margins under pressure",
				"Which themes the company talks about",
				"Trends across 99 large companies since 2021",
			],
		},
	];
	const root = document.getElementById("tools")!;
	config()
		.then((cfg) => {
			root.replaceChildren(...TOOLS.map((t) => {
				const url = cfg.tools[t.key];
				const open = url ? h("a", "btn btn-primary mt-6", `Open ${t.name}`) : h("span", "mt-6 inline-block text-sm text-muted", "Not open yet");
				if (url) (open as HTMLAnchorElement).href = url;
				return add(h("section", "sec"),
					add(h("div", "sec-head"), h("h2", "text-xl font-medium text-ink-strong", t.name), h("span", "sec-note", t.about)),
					add(h("ul", "divide-y divide-line text-ink"), ...t.points.map((p) => h("li", "py-2", p))),
					open);
			}));
		})
		.catch(() => root.replaceChildren(h("p", "text-sm text-muted", "The tools list is not available right now.")));
</script>
