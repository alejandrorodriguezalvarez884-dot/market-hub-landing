---
// Privacy: what Market Hub keeps about a reader and why. Its text, in both languages, is in
// i18n/legal.ts.
import Site from "../components/Site.astro";
import { link } from "../lib/site";
import type { Lang } from "../i18n";
import { privacy } from "../i18n/legal";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = privacy[lang];
const body = t.body({ account: link("/account/", lang), submit: link("/opinion/submit/", lang), contact: link("/contact/", lang) });
---

<Site title={t.title} description={t.description}>
	<div class="max-w-3xl space-y-5 text-[14px] leading-relaxed text-ink">
		<h1 class="text-2xl font-bold text-ink-strong">{t.title}</h1>
		<Fragment set:html={body} />
	</div>
</Site>
