---
// Terms: what Market Hub is offered under. Its text, in both languages, is in i18n/legal.ts.
import Site from "../components/Site.astro";
import { AUTHOR_URL, link } from "../lib/site";
import type { Lang } from "../i18n";
import { terms } from "../i18n/legal";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = terms[lang];
const body = t.body({ author: AUTHOR_URL, privacy: link("/privacy/", lang), account: link("/account/", lang), contact: link("/contact/", lang) });
---

<Site title={t.title} description={t.description}>
	<div class="max-w-3xl space-y-5 text-[14px] leading-relaxed text-ink">
		<h1 class="text-2xl font-bold text-ink-strong">{t.title}</h1>
		<Fragment set:html={body} />
	</div>
</Site>
