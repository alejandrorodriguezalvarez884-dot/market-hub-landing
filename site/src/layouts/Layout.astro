---
import "../styles/global.css";
import { SITE_NAME, link } from "../lib/site";

interface Props {
	title: string;
	description: string;
	// Kept out of search engines: only Market Hub's own writing is indexed, not other sources'
	// news and figures, nor the private area. Such a page names no canonical address.
	noindex?: boolean;
	// schema.org structured data for search engines, one JSON-LD script per object.
	schema?: object[];
}
const { title, description, noindex = false, schema = [] } = Astro.props;
// No "<" at all, so nothing in it can end the script element: JSON says the same with "<".
const jsonLd = (o: object) => JSON.stringify(o).replace(/</g, "\\u003c");
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site) : null;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={link("/favicon.svg")} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#0b0c0d" />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		{canonical && <link rel="canonical" href={canonical} />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		<title>{title}</title>
		{schema.map((o) => <script type="application/ld+json" is:inline set:html={jsonLd(o)} />)}
		<script is:inline>
			// Visits are counted by Cloudflare Web Analytics, which sets no cookie. On the public domain
			// only: a local preview counts nothing.
			if (/(^|\.)themarkethub\.app$/.test(location.hostname)) {
				const beacon = document.createElement("script");
				beacon.type = "module";
				beacon.src = "https://static.cloudflareinsights.com/beacon.min.js";
				beacon.dataset.cfBeacon = JSON.stringify({ token: "592b6306f5104483a0a6877de93785b5" });
				document.head.append(beacon);
			}
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="min-h-screen bg-page text-ink antialiased">
		<slot />
	</body>
</html>
