---
// Shell of the public portal: one header line with the search at its centre, and the footer.
// Signed-in users get a "My Hub" button to their private area.
import Layout from "../layouts/Layout.astro";
import { AUTHOR_URL, REPO_URL, SITE_NAME, link } from "../lib/site";
import AccountMenu from "./AccountMenu.astro";
import Logo from "./Logo.astro";
import Search from "./Search.astro";

interface Props {
	title: string;
	description: string;
}
const { title, description } = Astro.props;
const path = Astro.url.pathname;
// Only the public sections. The analysis tools need a session, so their links live in My Hub.
const nav = [
	{ href: link("/today/"), label: "Today", active: path.startsWith(link("/today/")) },
	{ href: link("/markets/"), label: "Markets", active: path.startsWith(link("/markets/")) },
	{ href: link("/news/"), label: "News", active: path.startsWith(link("/news/")) },
	{ href: link("/opinion/"), label: "Opinion", active: path.startsWith(link("/opinion/")) },
];
---

<Layout title={title === SITE_NAME ? title : `${title} — ${SITE_NAME}`} description={description}>
	<header class="sticky top-0 z-50 border-b border-line bg-page/95 backdrop-blur">
		<div class="mx-auto flex h-14 max-w-[1240px] items-center gap-4 px-5 lg:gap-8">
			<Logo />
			<nav class="hidden sm:block" aria-label="Main">
				<ul class="flex items-center gap-5 text-sm">
					{nav.map((l) => (
						<li>
							<a href={l.href} aria-current={l.active ? "page" : undefined}
								class:list={["border-b py-1 transition-colors hover:text-ink-strong", l.active ? "border-ink-strong text-ink-strong" : "border-transparent text-muted"]}>{l.label}</a>
						</li>
					))}
				</ul>
			</nav>
			<div class="ml-auto hidden w-full max-w-sm md:block"><Search compact id="header-search" /></div>
			<button id="search-toggle" type="button" class="ml-auto rounded-sm p-2 text-muted hover:text-ink-strong md:hidden" aria-label="Search" aria-expanded="false" aria-controls="mobile-search">
				<svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="9" cy="9" r="6"></circle><path d="m14 14 4 4" stroke-linecap="round"></path></svg>
			</button>
			<AccountMenu />
		</div>
		<div id="mobile-search" class="border-t border-line px-5 py-2 md:hidden" hidden><Search compact id="mobile-search-box" /></div>
		<nav class="border-t border-line sm:hidden" aria-label="Main">
			<ul class="flex gap-5 overflow-x-auto px-5 text-sm [scrollbar-width:none]">
				{nav.map((l) => (
					<li>
						<a href={l.href} aria-current={l.active ? "page" : undefined}
							class:list={["-mb-px block border-b py-2", l.active ? "border-ink-strong text-ink-strong" : "border-transparent text-muted"]}>{l.label}</a>
					</li>
				))}
			</ul>
		</nav>
	</header>
	<main class="mx-auto max-w-[1240px] px-5 pb-24 pt-8 sm:pt-12">
		<slot />
	</main>
	<footer class="border-t border-line">
		<div class="mx-auto grid max-w-[1240px] gap-6 px-5 py-8 text-[13px] text-muted md:grid-cols-[1fr_auto]">
			<div class="max-w-2xl space-y-2">
				<p>
					Prices can be delayed. Nothing here is investment advice or a recommendation to buy or sell anything. Past
					returns say nothing about future ones.
				</p>
				<p>
					Charts by <a href="https://www.tradingview.com/" class="link" rel="noopener">TradingView</a> Lightweight Charts™.
				</p>
			</div>
			<div class="flex flex-wrap items-start gap-x-5 gap-y-1">
				<a href={link("/tools/")} class="hover:text-ink-strong">About the tools</a>
				<a href={link("/privacy/")} class="hover:text-ink-strong">Privacy</a>
				<a href={REPO_URL} class="hover:text-ink-strong">Source</a>
				<a href={AUTHOR_URL} class="hover:text-ink-strong">Built by Alejandro Rodríguez Álvarez</a>
			</div>
		</div>
	</footer>
</Layout>

<script>
	const toggle = document.getElementById("search-toggle")!;
	const box = document.getElementById("mobile-search")!;
	toggle.addEventListener("click", () => {
		box.hidden = !box.hidden;
		toggle.setAttribute("aria-expanded", String(!box.hidden));
		if (!box.hidden) box.querySelector("input")?.focus();
	});
	// "/" goes to the search from anywhere on the page.
	document.addEventListener("keydown", (e) => {
		if (e.key !== "/" || e.metaKey || e.ctrlKey || e.altKey) return;
		if ((e.target as HTMLElement).closest("input, textarea, select, [contenteditable]")) return;
		const input = document.querySelector<HTMLInputElement>("#header-search input");
		if (!input || !input.offsetParent) return;
		e.preventDefault();
		input.focus();
	});
</script>
