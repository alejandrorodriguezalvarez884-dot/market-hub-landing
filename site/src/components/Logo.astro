---
import { SITE_NAME, link } from "../lib/site";
interface Props {
	href?: string;
	tag?: string;
}
const { href = "/", tag } = Astro.props;
---

<a href={link(href)} class="flex flex-none items-center gap-2 whitespace-nowrap text-[15px] font-bold tracking-tight text-ink-strong">
	<img src={link("/favicon.svg")} alt="" class="h-7 w-7" />
	<span>{SITE_NAME}</span>
	{tag && <span class="rounded bg-raised px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-muted">{tag}</span>}
</a>
