---
// The search box: ticker or company name. Suggestions come from the API (the SEC list of US
// listed companies). In "open" mode a choice opens the quote page; in "pick" mode it fires a
// `pick` event on the form instead (the portfolio editor uses that to add a stock).
import { link } from "../lib/site";

interface Props {
	large?: boolean;
	compact?: boolean; // the header's: no button, smaller
	autofocus?: boolean;
	mode?: "open" | "pick";
	button?: string;
	id?: string;
}
const { large = false, compact = false, autofocus = false, mode = "open", button = "Open", id = "search" } = Astro.props;
---

<form class="company-search relative" role="search" data-mode={mode} data-stock={link("/quote/")} id={id}>
	<label class="sr-only" for={`${id}-input`}>Ticker or company name</label>
	<div
		class:list={[
			"flex items-center gap-2 rounded-md border border-line-strong bg-page transition focus-within:border-accent",
			large ? "p-1.5 pl-4" : compact ? "py-0.5 pl-3 pr-1" : "p-1 pl-3",
		]}
	>
		<svg class="h-4 w-4 flex-none text-muted" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
			<circle cx="9" cy="9" r="6"></circle>
			<path d="m14 14 4 4" stroke-linecap="round"></path>
		</svg>
		<input
			id={`${id}-input`}
			type="search"
			autocomplete="off"
			spellcheck="false"
			autofocus={autofocus}
			placeholder={compact ? "Search ticker or company" : "Ticker or company name — AAPL, Microsoft, SPY…"}
			class:list={["min-w-0 flex-1 bg-transparent text-ink-strong placeholder:text-faint focus:outline-none [&::-webkit-search-cancel-button]:hidden", large ? "py-2 text-base" : compact ? "py-1 text-[13px]" : "py-1 text-sm"]}
		/>
		{!compact && (
			<button type="submit" class:list={["btn btn-primary flex-none", large ? "px-5 py-2" : "px-3 py-1.5"]}>
				{button}
			</button>
		)}
	</div>
	<ul class="search-list" role="listbox" hidden></ul>
	<p class="search-note mt-2 text-xs text-muted" hidden></p>
</form>

<script>
	import { API } from "../lib/api";
	import { tidyName } from "../lib/site";

	type Found = { ticker: string; name: string };

	for (const form of document.querySelectorAll<HTMLFormElement>(".company-search")) {
		const input = form.querySelector("input")!;
		const list = form.querySelector<HTMLElement>(".search-list")!;
		const note = form.querySelector<HTMLElement>(".search-note")!;
		const go = (c: Found) => {
			if (form.dataset.mode === "pick") {
				form.dispatchEvent(new CustomEvent("pick", { detail: c }));
				input.value = "";
				found = [];
				draw();
				return;
			}
			window.location.href = `${form.dataset.stock}?t=${encodeURIComponent(c.ticker)}`;
		};

		let found: Found[] = [];
		let answered = "";
		let active = -1;
		let seq = 0;
		let timer: ReturnType<typeof setTimeout> | undefined;

		function draw() {
			list.replaceChildren(
				...found.map((c, i) => {
					const li = document.createElement("li");
					li.setAttribute("role", "option");
					li.setAttribute("aria-selected", String(i === active));
					const name = document.createElement("span");
					name.className = "min-w-0 truncate text-ink";
					name.textContent = tidyName(c.name);
					const ticker = document.createElement("span");
					ticker.className = "flex-none text-xs font-semibold tabular-nums text-ink-strong";
					ticker.textContent = c.ticker;
					li.append(name, ticker);
					li.addEventListener("pointerdown", (e) => (e.preventDefault(), go(c)));
					return li;
				}),
			);
			list.hidden = found.length === 0;
		}

		function say(text: string) {
			note.textContent = text;
			note.hidden = !text;
		}

		async function search(q: string) {
			const mine = ++seq;
			if (!q) {
				found = [];
				answered = "";
				say("");
				return draw();
			}
			let next: Found[] = [];
			let message = "";
			try {
				const res = await fetch(`${API}/api/search?q=${encodeURIComponent(q)}`);
				if (!res.ok) throw new Error(String(res.status));
				next = (await res.json()).companies;
				if (!next.length) message = "No US-listed company with that name or ticker.";
			} catch {
				message = "The search is not available right now. You can still type a ticker and press Enter.";
			}
			if (mine !== seq) return;
			found = next;
			answered = q;
			active = -1;
			say(message);
			draw();
		}

		input.addEventListener("input", () => {
			clearTimeout(timer);
			timer = setTimeout(() => search(input.value.trim()), 180);
		});
		input.addEventListener("keydown", (e) => {
			if (e.key === "Escape") return void (list.hidden = true);
			if ((e.key !== "ArrowDown" && e.key !== "ArrowUp") || !found.length) return;
			e.preventDefault();
			active = (active + (e.key === "ArrowDown" ? 1 : -1) + found.length) % found.length;
			draw();
		});
		input.addEventListener("focus", () => (list.hidden = found.length === 0));
		input.addEventListener("blur", () => (list.hidden = true));

		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			const q = input.value.trim();
			if (!q) return input.focus();
			clearTimeout(timer);
			if (answered !== q) await search(q);
			const pick = found[Math.max(active, 0)];
			if (pick) go(pick);
			else if (/^[A-Za-z][A-Za-z0-9.\-]{0,9}$/.test(q)) go({ ticker: q.toUpperCase(), name: q.toUpperCase() });
		});
	}
</script>

<style is:global>
	.search-list {
		position: absolute;
		z-index: 40;
		left: 0;
		right: 0;
		margin-top: 6px;
		padding: 6px;
		border-radius: 6px;
		border: 1px solid var(--color-line-strong);
		background: var(--color-panel);
		box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
		min-width: 280px;
	}
	.search-list[hidden] {
		display: none;
	}
	.search-list li {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 8px 10px;
		border-radius: 4px;
		font-size: 13px;
		cursor: pointer;
	}
	.search-list li:hover,
	.search-list li[aria-selected="true"] {
		background: var(--color-raised);
	}
</style>
