---
// Top-right of the public header. For visitors, the way into My Hub, the site's private area
// with its tools, as the main button, and "Sign in" beside it for those who have an account; for
// signed-in users, the same button straight to My Hub, their picture and a menu.
import { link } from "../lib/site";
---

<div id="account" class="relative flex flex-none items-center gap-3">
	<span id="signin-link" class="flex items-center gap-3" hidden>
		<a href={link("/signin/")} class="hidden text-sm text-muted hover:text-ink-strong sm:inline">Sign in</a>
		<a href={link("/signin/")} class="btn btn-primary">Open My Hub</a>
	</span>
</div>

<script>
	import { signedIn } from "../lib/api";
	import { avatar, signOut } from "../lib/avatar";
	import { add, h, linkTo } from "../lib/dom";
	import { link } from "../lib/site";

	const box = document.getElementById("account")!;
	const signin = document.getElementById("signin-link")!;
	signedIn()
		.then((who) => {
			if (!who) return void (signin.hidden = false);
			signin.remove();
			const hub = linkTo(link("/dashboard/"), "btn btn-primary hidden sm:inline-flex", "Open My Hub");
			const button = h("button", "rounded-full ring-2 ring-transparent hover:ring-line-strong");
			button.type = "button";
			button.setAttribute("aria-label", "Account");
			button.append(avatar(who.user));
			const menu = h("div", "absolute right-0 top-full z-50 mt-2 w-64 rounded-[3px] border border-line-strong bg-panel p-1.5 text-sm shadow-2xl shadow-black/60");
			menu.hidden = true;
			const item = (href: string, text: string) => linkTo(href, "block rounded px-3 py-2 text-ink hover:bg-raised", text);
			const out = h("button", "w-full rounded px-3 py-2 text-left text-ink hover:bg-raised", "Sign out");
			out.type = "button";
			out.addEventListener("click", () => signOut(link("/")));
			add(menu,
				add(h("div", "border-b border-line px-3 pb-2.5 pt-1.5"), h("div", "font-semibold text-ink-strong", who.user.name), h("div", "truncate text-xs text-muted", who.user.email)),
				add(h("div", "pt-1.5"), item(link("/dashboard/"), "My Hub"), item(link("/portfolio/"), "Portfolio"), item(link("/account/"), "Account and data"), out));
			button.addEventListener("click", () => (menu.hidden = !menu.hidden));
			document.addEventListener("click", (e) => !box.contains(e.target as Node) && (menu.hidden = true));
			add(box, hub, button, menu);
		})
		.catch(() => (signin.hidden = false));
</script>
