---
// Shell of the private area (My Hub): a sidebar with the user's sections, a reminder that only
// they see it, and the way back to the public portal (the tools, and a button to the home page).
// Pages check the session themselves.
import Layout from "../layouts/Layout.astro";
import { FUNDAMENTALS_URL, RADAR_URL, SITE_NAME, link } from "../lib/site";
import Logo from "./Logo.astro";

interface Props {
	title: string;
	description: string;
}
const { title, description } = Astro.props;
const path = Astro.url.pathname;
const icons: Record<string, string> = {
	overview: "M3 13h6V3H3v10Zm0 8h6v-6H3v6Zm8 0h10V11H11v10Zm0-18v6h10V3H11Z",
	portfolio: "M4 7h16v12H4zM9 7V5h6v2",
	analysis: "M12 3a9 9 0 1 0 9 9h-9V3Zm3 .5A9 9 0 0 1 20.5 9H15V3.5Z",
	community: "M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm8 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM2 20a6 6 0 0 1 12 0m1.5-5.5A6 6 0 0 1 22 20",
	tools: "M4 19V9m6 10V5m6 14v-7m4 7H2",
	account: "M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 9a7 7 0 0 1 14 0",
	markets: "M3 17l6-6 4 4 8-8M15 7h6v6",
	earnings: "M6 3h9l4 4v14H6zM14 3v5h5M9 13h7M9 17h7",
	news: "M4 5h13v14H6a2 2 0 0 1-2-2V5Zm13 4h3v8a2 2 0 0 1-2 2M8 9h5M8 13h5",
	opinion: "M4 5h16v11H9l-5 4V5Zm4 4h8M8 12h5",
};
const mine = [
	{ href: link("/dashboard/"), label: "Overview", icon: "overview" },
	{ href: link("/analysis/"), label: "Analysis", icon: "analysis" },
	{ href: link("/community/"), label: "Community", icon: "community" },
	{ href: link("/portfolio/"), label: "Portfolio", icon: "portfolio" },
	{ href: link("/account/"), label: "Account and data", icon: "account" },
].map((l) => ({ ...l, active: path.startsWith(l.href) }));
// The tools are reached from here only: the public header does not name them.
const tools = [
	{ href: `${FUNDAMENTALS_URL}/`, label: "Fundamentals", icon: "tools" },
	{ href: `${RADAR_URL}/`, label: "Earnings", icon: "earnings" },
];
const groups = [
	{ label: "Tools", links: tools },
	{ label: "Explore", links: [{ href: link("/markets/"), label: "Markets", icon: "markets" }, { href: link("/news/"), label: "News", icon: "news" }, { href: link("/opinion/"), label: "Opinion", icon: "opinion" }] },
];
---

<Layout title={`${title} — ${SITE_NAME}`} description={description}>
	<div class="lg:flex">
		<aside class="sticky top-0 hidden h-screen w-60 flex-none flex-col border-r border-line bg-deep lg:flex">
			<div class="flex h-14 items-center border-b border-line px-4"><Logo href="/dashboard/" tag="My Hub" /></div>
			<div class="mx-3 mt-4 flex items-center gap-2 rounded-md border border-line bg-panel px-3 py-2 text-[11px] text-muted">
				<svg class="h-3.5 w-3.5 flex-none text-up" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
				<span>Private area. Only you see it.</span>
			</div>
			<nav class="mt-4 flex-1 overflow-y-auto px-3" aria-label="My Hub">
				<p class="label px-2 pb-1.5">Your space</p>
				<ul class="space-y-0.5">
					{mine.map((l) => (
						<li>
							<a href={l.href} aria-current={l.active ? "page" : undefined}
								class:list={["flex items-center gap-2.5 rounded px-2 py-2 text-[13px] font-semibold transition-colors", l.active ? "bg-raised text-ink-strong" : "text-ink hover:bg-raised"]}>
								<svg class="h-4 w-4 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[l.icon]}></path></svg>
								{l.label}
							</a>
						</li>
					))}
				</ul>
				{groups.map((g) => (
					<>
						<p class="label mt-6 px-2 pb-1.5">{g.label}</p>
						<ul class="space-y-0.5">
							{g.links.map((l) => (
								<li>
									<a href={l.href} class="flex items-center gap-2.5 rounded px-2 py-2 text-[13px] font-medium text-muted transition-colors hover:bg-raised hover:text-ink">
										<svg class="h-4 w-4 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[l.icon]}></path></svg>
										{l.label}
									</a>
								</li>
							))}
						</ul>
					</>
				))}
			</nav>
			<div class="px-3 pb-3"><a href={link("/")} class="btn btn-ghost w-full py-1.5 text-[13px]"><span aria-hidden="true">←</span> Back to the home page</a></div>
			<div id="app-user" class="border-t border-line p-3"></div>
		</aside>

		<div class="min-w-0 flex-1">
			<header class="sticky top-0 z-40 border-b border-line bg-deep/95 backdrop-blur lg:hidden">
				<div class="flex h-14 items-center justify-between gap-3 px-4">
					<Logo href="/dashboard/" tag="My Hub" />
					<div id="app-user-mobile"></div>
				</div>
				<nav class="border-t border-line" aria-label="My Hub">
					<ul class="flex gap-1 overflow-x-auto px-2 text-[13px] font-semibold">
						<li><a href={link("/")} class="block whitespace-nowrap border-b-2 border-transparent px-3 py-2 text-muted"><span aria-hidden="true">←</span> Home</a></li>
						{[...mine, ...tools.map((l) => ({ ...l, active: false })), { href: link("/markets/"), label: "Markets", active: false }].map((l) => (
							<li>
								<a href={l.href} aria-current={l.active ? "page" : undefined}
									class:list={["block whitespace-nowrap border-b-2 px-3 py-2", l.active ? "border-accent text-ink-strong" : "border-transparent text-muted"]}>{l.label}</a>
							</li>
						))}
					</ul>
				</nav>
			</header>
			<main class="mx-auto max-w-[1280px] px-4 pb-16 pt-6 lg:px-8 lg:pt-8">
				<slot />
				<p class="mt-14 border-t border-line pt-5 text-xs leading-relaxed text-muted">
					Prices from the data provider, possibly delayed. Gains and losses are measured against the average cost you entered.
					Nothing here is investment advice or a recommendation to buy or sell any security.
				</p>
			</main>
		</div>
	</div>
</Layout>

<script>
	import { signedIn } from "../lib/api";
	import { avatar, signOut } from "../lib/avatar";
	import { add, h } from "../lib/dom";
	import { link } from "../lib/site";

	signedIn()
		.then((who) => {
			if (!who) return;
			const out = (cls: string) => {
				const b = h("button", cls, "Sign out");
				b.type = "button";
				b.addEventListener("click", () => signOut(link("/")));
				return b;
			};
			document.getElementById("app-user")!.replaceChildren(
				add(h("div", "flex items-center gap-2.5"), avatar(who.user),
					add(h("div", "min-w-0 flex-1"), h("div", "truncate text-[13px] font-semibold text-ink-strong", who.user.name), h("div", "truncate text-[11px] text-muted", who.user.email))),
				out("btn btn-ghost mt-3 w-full py-1.5 text-xs"));
			document.getElementById("app-user-mobile")!.replaceChildren(add(h("div", "flex items-center gap-2"), out("text-xs font-semibold text-muted hover:text-ink"), avatar(who.user)));
		})
		.catch(() => {});
</script>
