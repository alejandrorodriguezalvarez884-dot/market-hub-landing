---
// Shell of the private area (My Hub): a sidebar with the user's sections, a reminder that only
// they see it, and the way back to the public portal (the tools, and a button to the home page).
// Pages check the session themselves.
import Layout from "../layouts/Layout.astro";
import { FUNDAMENTALS_URL, OPTIONS_URL, PEERS_URL, PLAYGROUND_URL, RADAR_URL, SITE_NAME, bareAt, langAt, link } from "../lib/site";
import { layout } from "../i18n/layout";
import Logo from "./Logo.astro";

interface Props {
	title: string;
	description: string;
	wide?: boolean; // a page that fills the window (a wall of charts) rather than a column
}
const { title, description, wide = false } = Astro.props;
const path = Astro.url.pathname;
const lang = langAt(path);
const t = layout[lang];
const L = (p: string) => link(p, lang);
const bare = bareAt(path);
const icons: Record<string, string> = {
	overview: "M3 13h6V3H3v10Zm0 8h6v-6H3v6Zm8 0h10V11H11v10Zm0-18v6h10V3H11Z",
	portfolio: "M4 7h16v12H4zM9 7V5h6v2",
	analysis: "M12 3a9 9 0 1 0 9 9h-9V3Zm3 .5A9 9 0 0 1 20.5 9H15V3.5Z",
	watchlist: "M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Zm10 3a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z",
	community: "M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm8 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM2 20a6 6 0 0 1 12 0m1.5-5.5A6 6 0 0 1 22 20",
	tools: "M4 19V9m6 10V5m6 14v-7m4 7H2",
	share: "M4 12v7h16v-7M12 3v12M8 7l4-4 4 4",
	trophy: "M8 4h8v5a4 4 0 0 1-8 0V4ZM8 6H5a3 3 0 0 0 3 4m8-4h3a3 3 0 0 1-3 4m-4 3v4m-4 4h8m-6-4h4",
	bot: "M6 9h12v10H6zM12 9V5m-1.5-1h3M9.5 13.5h.01M14.5 13.5h.01M10 16.5h4M3 13v3M21 13v3",
	account: "M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 9a7 7 0 0 1 14 0",
	markets: "M3 17l6-6 4 4 8-8M15 7h6v6",
	earnings: "M6 3h9l4 4v14H6zM14 3v5h5M9 13h7M9 17h7",
	news: "M4 5h13v14H6a2 2 0 0 1-2-2V5Zm13 4h3v8a2 2 0 0 1-2 2M8 9h5M8 13h5",
	opinion: "M4 5h16v11H9l-5 4V5Zm4 4h8M8 12h5",
	media: "M3 6h18v12H3zM10 9.5v5l4.5-2.5-4.5-2.5Z",
	peers: "M4 7a2 2 0 1 0 4 0 2 2 0 1 0-4 0M16 6a2 2 0 1 0 4 0 2 2 0 1 0-4 0M11 18a2 2 0 1 0 4 0 2 2 0 1 0-4 0M8 6.8l8-.6M7 8.7l5 7.6M17.2 7.8l-3.3 8.4",
	playground: "M4 4h7v9H4zM13 4h7v5h-7zM13 11h7v9h-7zM4 15h7v5H4z",
	options: "M3 20h18M3 15h7l10-10",
};
const mine = [
	{ href: L("/dashboard/"), label: t.overview, icon: "overview" },
	{ href: L("/analysis/"), label: t.analysis, icon: "analysis" },
	{ href: L("/watchlist/"), label: t.watchlist, icon: "watchlist" },
	{ href: L("/portfolio/"), label: t.portfolio, icon: "portfolio" },
	{ href: L("/account/"), label: t.accountData, icon: "account" },
].map((l) => ({ ...l, active: path.startsWith(l.href) }));
// Community is a section of its own: sharing a portfolio, the monthly competition and the bot competition.
const community = [
	{ href: L("/community/"), label: t.sharePortfolio, icon: "share", active: path === L("/community/") },
	{ href: L("/community/competitions/"), label: t.monthly, icon: "trophy", active: path.startsWith(L("/community/competitions/")) },
	{ href: L("/community/bots/"), label: t.bots, icon: "bot", active: path.startsWith(L("/community/bots/")) },
];
// The tools are reached from here only: the public header does not name them.
const tools = [
	{ href: `${FUNDAMENTALS_URL}/`, label: t.fundamentals, icon: "tools" },
	{ href: `${RADAR_URL}/`, label: t.earnings, icon: "earnings" },
	{ href: `${PEERS_URL}/`, label: t.peers, icon: "peers" },
	{ href: `${PLAYGROUND_URL}/`, label: t.playground, icon: "playground" },
	{ href: `${OPTIONS_URL}/`, label: t.options, icon: "options" },
];
const groups = [
	{ label: t.tools, links: tools },
	{ label: t.explore, links: [{ href: L("/markets/"), label: t.nav.markets, icon: "markets" }, { href: L("/news/"), label: t.nav.news, icon: "news" }, { href: L("/opinion/"), label: t.nav.opinion, icon: "opinion" }, { href: L("/media/"), label: t.nav.media, icon: "media" }] },
];
---

<Layout noindex title={`${title} — ${SITE_NAME}`} description={description}>
	<div class="lg:flex">
		<aside class="sticky top-0 hidden h-screen w-60 flex-none flex-col border-r border-line bg-deep lg:flex">
			<div class="flex h-14 items-center border-b border-line px-4"><Logo href="/dashboard/" tag={t.myHub} /></div>
			<div class="mx-3 mt-4 flex items-center gap-2 rounded-md border border-line bg-panel px-3 py-2 text-[11px] text-muted">
				<svg class="h-3.5 w-3.5 flex-none text-up" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
				<span>{t.private}</span>
			</div>
			<nav class="mt-4 flex-1 overflow-y-auto px-3" aria-label={t.myHub}>
				<p class="label px-2 pb-1.5">{t.yourSpace}</p>
				<ul class="space-y-0.5">
					{mine.map((l) => (
						<li>
							<a href={l.href} aria-current={l.active ? "page" : undefined}
								class:list={["flex items-center gap-2.5 rounded px-2 py-2 text-[13px] font-semibold transition-colors", l.active ? "bg-raised text-ink-strong" : "text-ink hover:bg-raised"]}>
								<svg class="h-4 w-4 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[l.icon]}></path></svg>
								{l.label}
							</a>
						</li>
					))}
				</ul>
				<p class="label mt-6 px-2 pb-1.5">{t.community}</p>
				<ul class="space-y-0.5">
					{community.map((l) => (
						<li>
							<a href={l.href} aria-current={l.active ? "page" : undefined}
								class:list={["flex items-center gap-2.5 rounded px-2 py-2 text-[13px] font-semibold transition-colors", l.active ? "bg-raised text-ink-strong" : "text-ink hover:bg-raised"]}>
								<svg class="h-4 w-4 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[l.icon]}></path></svg>
								{l.label}
							</a>
						</li>
					))}
				</ul>
				{groups.map((g) => (
					<>
						<p class="label mt-6 px-2 pb-1.5">{g.label}</p>
						<ul class="space-y-0.5">
							{g.links.map((l) => (
								<li>
									<a href={l.href} class="flex items-center gap-2.5 rounded px-2 py-2 text-[13px] font-medium text-muted transition-colors hover:bg-raised hover:text-ink">
										<svg class="h-4 w-4 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[l.icon]}></path></svg>
										{l.label}
									</a>
								</li>
							))}
						</ul>
					</>
				))}
			</nav>
			<div class="px-3 pb-3"><a href={L("/")} class="btn btn-ghost w-full py-1.5 text-[13px]"><span aria-hidden="true">←</span> {t.backHome}</a></div>
			<div id="app-user" class="border-t border-line p-3"></div>
		</aside>

		<div class="min-w-0 flex-1">
			<header class="sticky top-0 z-40 border-b border-line bg-deep/95 backdrop-blur lg:hidden">
				<div class="flex h-14 items-center justify-between gap-3 px-4">
					<Logo href="/dashboard/" tag={t.myHub} />
					<div id="app-user-mobile"></div>
				</div>
				<nav class="border-t border-line" aria-label={t.myHub}>
					<ul class="flex gap-1 overflow-x-auto px-2 text-[13px] font-semibold">
						<li><a href={L("/")} class="block whitespace-nowrap border-b-2 border-transparent px-3 py-2 text-muted"><span aria-hidden="true">←</span> {t.home}</a></li>
						{[...mine, ...community, ...tools.map((l) => ({ ...l, active: false })), { href: L("/markets/"), label: t.nav.markets, active: false }].map((l) => (
							<li>
								<a href={l.href} aria-current={l.active ? "page" : undefined}
									class:list={["block whitespace-nowrap border-b-2 px-3 py-2", l.active ? "border-accent text-ink-strong" : "border-transparent text-muted"]}>{l.label}</a>
							</li>
						))}
					</ul>
				</nav>
			</header>
			<main class:list={["mx-auto px-4 pb-16 pt-6 lg:pt-8", wide ? "max-w-[1920px] lg:px-6" : "max-w-[1280px] lg:px-8"]}>
				<slot />
				<div class="mt-14 flex flex-wrap items-start justify-between gap-x-8 gap-y-3 border-t border-line pt-5 text-xs leading-relaxed text-muted">
					<p class="max-w-3xl">{t.hubFoot}</p>
					<span class="lang-switch flex gap-2" aria-label={t.language} role="group">
						<a href={link(bare, "en")} data-lang="en" hreflang="en" lang="en" aria-current={lang === "en" ? "true" : undefined} class="hover:text-ink-strong">English</a>
						<span aria-hidden="true">·</span>
						<a href={link(bare, "es")} data-lang="es" hreflang="es" lang="es" aria-current={lang === "es" ? "true" : undefined} class="hover:text-ink-strong">Español</a>
					</span>
				</div>
			</main>
		</div>
	</div>
</Layout>

<script>
	import { signedIn } from "../lib/api";
	import { avatar, signOut } from "../lib/avatar";
	import { add, h } from "../lib/dom";
	import { link } from "../lib/site";
	import { lang } from "../i18n";
	import { layout } from "../i18n/layout";

	const t = layout[lang()];
	signedIn()
		.then((who) => {
			if (!who) return;
			const out = (cls: string) => {
				const b = h("button", cls, t.signOut);
				b.type = "button";
				b.addEventListener("click", () => signOut(link("/")));
				return b;
			};
			document.getElementById("app-user")!.replaceChildren(
				add(h("div", "flex items-center gap-2.5"), avatar(who.user),
					add(h("div", "min-w-0 flex-1"), h("div", "truncate text-[13px] font-semibold text-ink-strong", who.user.name), h("div", "truncate text-[11px] text-muted", who.user.email))),
				out("btn btn-ghost mt-3 w-full py-1.5 text-xs"));
			document.getElementById("app-user-mobile")!.replaceChildren(add(h("div", "flex items-center gap-2"), out("text-xs font-semibold text-muted hover:text-ink"), avatar(who.user)));
		})
		.catch(() => {});
</script>
