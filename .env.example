# `make env` (also run by install, api, serve and deploy) copies this to .env and generates
# SESSION_SECRET. .env is ignored by git: never commit keys.

# OAuth client of the site: Google Auth Platform -> Clients -> Web application.
# Authorised JavaScript origins: http://localhost:4321, http://localhost:8080 and the public URL.
# Public by design (it goes to the browser), so it lives here and not only in .env.
GOOGLE_CLIENT_ID=818229650855-3dq57ote5eq25hhdmru29k3mg852jpnb.apps.googleusercontent.com
# Signs the session cookie. `make env` generates it; never commit it.
SESSION_SECRET=
# Financial Modeling Prep (same key as fundamentals-lab)
FMP_API_KEY=
# The SEC asks for a contact in the User-Agent: "market-hub you@example.com". The news desk reads
# the SEC's filings with it too.
SEC_USER_AGENT=
# Optional. With it, Claude Haiku writes each news item from its official document (about half a
# cent per filing; no cap here, the credit on the API account is the limit). Without it the items
# keep the titles the code writes. To deploy with a key that is already in Secret Manager, leave
# this empty and name the secret in ANTHROPIC_SECRET.
ANTHROPIC_API_KEY=
ANTHROPIC_SECRET=
# Optional news settings (defaults in src/markethub/config.py): NEWS_TTL_SECONDS (900),
# NEWS_UNIVERSE (the 500 largest companies), NEWS_PRESS_FEEDS ("Name|feed URL,..."; empty turns
# the press headlines off), MARKETHUB_SAMPLE_NEWS=1 (placeholder headlines, no network).

# Addresses of the tools the portal opens. They sit on subdomains of the portal's domain and
# share its sign-in (see MARKETHUB_COOKIE_DOMAIN).
EARNINGS_RADAR_URL=https://radar.themarkethub.app
FUNDAMENTALS_LAB_URL=https://fundamentals.themarkethub.app
# The portal's domain: the session cookie is shared with its subdomains. Leave empty to keep it
# on the host that set it.
MARKETHUB_COOKIE_DOMAIN=themarkethub.app

# The owner's Google addresses, separated by commas: signed in with one of them, any comment under
# an opinion article can be taken down.
MARKETHUB_ADMINS=

# Signing in with an email and a password kept by us is on. Set it to 0 to leave Google as the only way in.
# MARKETHUB_PASSWORD_LOGIN=1

# My Hub: the model that reads a portfolio back in sentences (same key as the news), and how many
# times a day a user's changing portfolio is read. Both optional.
# INSIGHTS_MODEL=claude-haiku-4-5
# INSIGHTS_PER_USER_PER_DAY=6

# Local development over plain http (never in production)
MARKETHUB_INSECURE_COOKIES=1
